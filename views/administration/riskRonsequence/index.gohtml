{{ define "content" }}
<div
  class="px-4 w-full"
  x-data="{ 
    isEdit: false, 
    id: '', 
    name: '',
    description: '',
    reportable: 'Yes',
    sequence: '',
    severity_level: '',
    showUpload: false,
    
    init() {
        this.checkFlash();
        // Daftarkan fungsi ke window agar bisa dipanggil dari 'slot'
        window.openEdit = (id, name, desc, report, seq, sev) => {
            this.isEdit = true;
            this.id = id;
            this.name = name;
            this.description = desc;
            this.reportable = report || 'Yes';
            this.sequence = seq;
            this.severity_level = sev;
            document.getElementById('risk_consequence_modal').showModal();
        };
        window.openCreate = () => {
            this.isEdit = false;
            this.id = '';
            this.name = '';
            this.description = '';
            this.reportable = 'Yes';
            this.sequence = '';
            this.severity_level = '';
            document.getElementById('risk_consequence_modal').showModal();
        };
    },

    checkFlash() {
        const getCookie = (name) => {
            let value = `; ${document.cookie}`;
            let parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }
        const msg = getCookie('flash_msg');
        const type = getCookie('flash_type');
        if (msg) {
            const decodedMsg = decodeURIComponent(msg.replace(/\+/g, ' '));
            if (window.showToast) window.showToast(decodedMsg, type || 'success');
            document.cookie = 'flash_msg=; Max-Age=-99999999; path=/;';
            document.cookie = 'flash_type=; Max-Age=-99999999; path=/;';
        }
    },

    getAction() {
        return this.isEdit ? '/administration/risk/consequence/update' : '/administration/risk/consequence/store';
    }
}"
>
  {{ template "tabs" . }}
</div>
{{ end }}

{{ define "tab" }}
<div
  class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center gap-4 mb-4"
>
  <div class="space-x-2 w-full">
    <button
      class="btn btn-accent btn-xs w-full sm:w-auto"
      @click="window.openCreate()"
    >
      {{ lucide "plus" (dict "class" "size-4") }}
      <span>Tambah Data</span>
    </button>
    <button
      class="btn btn-warning btn-xs w-full sm:w-auto"
      @click="showUpload = true"
    >
      {{ lucide "file-up" (dict "class" "size-4") }}
      <span>Upload Excel</span>
    </button>
  </div>

  <div
    class="w-full sm:w-auto"
    x-data="{ 
        searchQuery: '{{ .Search }}',
        doSearch() {
            if(this.searchQuery === '{{ .Search }}') return;
            window.location.href = '/administration/risk/consequence?page=1&search=' + encodeURIComponent(this.searchQuery);
        }
    }"
  >
    {{ template "input-floating" (dict "Label" "Cari Consequence" "Name" "search" "Placeholder" "Ketik untuk mencari..." "Attr" "x-model='searchQuery' @input.debounce.750ms='doSearch()' autofocus" ) }}
  </div>
</div>

<dialog id="risk_consequence_modal" class="modal">
  <div class="modal-box p-0 border border-base-300 shadow-2xl max-w-2xl">
    <form :action="getAction()" method="POST">
      <div class="card bg-base-100 card-xs shadow-sm">
        <div class="card-body gap-4">
          <h2
            class="card-title text-base-content font-semibold mb-1"
            x-text="isEdit ? 'Edit Risk Consequence' : 'Tambah Risk Consequence'"
          ></h2>

          <input type="hidden" name="id" x-model="id" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {{ template "input-floating" (dict "Label" "Name" "Placeholder" "Name..." "Name" "name" "Required" true "Attr" "x-model='name'" ) }}

            <div>
              <select
                name="reportable"
                class="select select-xs w-full focus:outline-none"
                x-model="reportable"
              >
                <option value="Yes">Yes</option>
                <option value="No">No</option>
              </select>
            </div>
          </div>

          <fieldset class="fieldset">
            <label class="floating-label">
              <textarea
                name="description"
                class="textarea w-full text-xs"
                x-model="description"
                placeholder="Isi detail kriteria dampak..."
              ></textarea>
              <span>Isi detail kriteria dampak</span>
            </label>
          </fieldset>
          <div class="grid grid-cols-2 gap-4">
            {{ template "input-floating" (dict "Label" "Sequence" "Name" "sequence" "Placeholder" "0" "Attr" "x-model='sequence' type='number'" ) }}
            {{ template "input-floating" (dict "Label" "Severity Level" "Placeholder" "1-5" "Name" "severity_level" "Attr" "x-model='severity_level' type='number'" ) }}
          </div>
        </div>
        <div class="modal-action p-4 bg-base-200/50 gap-2">
          <button
            type="button"
            class="btn btn-ghost btn-xs"
            @click="document.getElementById('risk_consequence_modal').close()"
          >
            Batal
          </button>
          <button type="submit" class="btn btn-primary btn-xs px-6">
            {{ lucide "save" (dict "class" "size-4") }} Simpan
          </button>
        </div>
      </div>
    </form>
  </div>
</dialog>

<dialog
  id="upload_modal"
  class="modal"
  :class="{ 'modal-open': showUpload }"
  x-cloak
>
  <div class="modal-box p-0 border border-base-300 shadow-2xl">
    <form
      action="/administration/risk/consequence/upload"
      method="POST"
      enctype="multipart/form-data"
      x-data="{ importing: false }"
      @submit="importing = true"
    >
      <div class="card bg-base-100 card-xs shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-base-content font-semibold mb-3 text-sm">
            Upload Consequence Data
          </h2>
          <div class="bg-info/10 p-3 rounded-lg mb-4 border border-info/20">
            <p
              class="text-[10px] leading-relaxed text-info flex gap-2 items-start"
            >
              {{ lucide "info" (dict "class" "size-4 shrink-0") }}
              <span
                >Kolom Excel: <b>A: Name</b>, <b>B: Reportable</b>,
                <b>C: Description</b>, <b>D: Sequence</b>,
                <b>E: Severity</b>.</span
              >
            </p>
          </div>
          <input
            type="file"
            class="file-input file-input-bordered file-input-xs file-input-accent w-full"
            name="excel_file"
            required
          />
        </div>
        <div class="modal-action p-4 bg-base-200/50 gap-2">
          <button
            type="button"
            class="btn btn-ghost btn-xs"
            @click="showUpload = false"
            :disabled="importing"
          >
            Batal
          </button>
          <button
            type="submit"
            class="btn btn-accent btn-xs px-6"
            :disabled="importing"
          >
            <span x-show="!importing" class="flex items-center gap-2"
              >{{ lucide "upload" (dict "class" "size-4") }} Mulai Import</span
            >
            <span x-show="importing">Memproses...</span>
          </button>
        </div>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop" @click="showUpload = false">
    <button>close</button>
  </form>
</dialog>
{{ template "pagination" . }}
<div
  class="overflow-x-auto bg-base-100 shadow-lg rounded-lg my-4 border border-base-300"
>
  <table class="table table-zebra table-xs">
    <thead class="bg-base-300/50">
      <tr>
        <th class="w-16">Sev</th>
        <th>Name</th>
        <th>Reportable</th>
        <th>Description</th>
        <th class="text-center w-32">Aksi</th>
      </tr>
    </thead>
    <tbody>
      {{ range.Consequences }}
      <tr>
        <td class="font-bold text-center bg-base-200/50 italic">
          {{ .SeverityLevel }}
        </td>
        <td class="font-medium whitespace-nowrap">{{ .Name }}</td>
        <td>
          <span
            class="badge badge-xs font-bold"
            :class="'{{ .Reportable }}' === 'Yes' ? 'badge-success' : 'badge-ghost'"
            >{{ .Reportable }}</span
          >
        </td>
        <td>
          <div
            class="max-w-xs md:max-w-md text-[10px] leading-tight line-clamp-2 opacity-70"
          >
            {{ .Description }}
          </div>
        </td>
        <td class="flex justify-center gap-2">
          <button
            type="button"
            class="btn btn-square btn-warning btn-xs"
            @click="window.openEdit('{{ .ID }}', '{{ .Name }}', `{{ .Description }}`, '{{ .Reportable }}', '{{ .Sequence }}', '{{ .SeverityLevel }}')"
          >
            {{ lucide "pencil" (dict "class" "size-4") }}
          </button>
          <form
            action="/administration/risk/consequence/delete"
            method="POST"
            @submit.prevent="if(confirm('Hapus {{ .Name }}?')) $el.submit()"
          >
            <input type="hidden" name="id" value="{{ .ID }}" />
            <button type="submit" class="btn btn-square btn-error btn-xs">
              {{ lucide "trash-2" (dict "class" "size-4") }}
            </button>
          </form>
        </td>
      </tr>
      {{ end }}
    </tbody>
  </table>
</div>
{{ end }}
