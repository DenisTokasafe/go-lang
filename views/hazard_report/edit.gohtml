{{ define "title" }}Detail Hazard - SENTRY{{ end }}
{{ define "content" }}

<div class="px-4 w-full" x-data="{

	// =========================
	// BASIC STATE
	// =========================
	is_verified: 'false',
	type_error: false,
	status_area: '{{ .StatusArea }}', // default value
	status_laporan: '{{ printf "%s" .Hazard.Status }}',
	isClosed: '{{ printf "%s" .Hazard.Status }}' === 'closed',
	status_area_error: false,
	description: `{{ .Hazard.Deskripsi }}`,
	corrective_action: `{{ .Hazard.CorrectiveAction }}`,

	dokumentasi_desc: [],
	dokumentasi_corrective: [],

	// =========================
	// EVENT DATA
	// =========================

	event_category_id: '{{ .Hazard.EventCategory.ParentID }}',
	event_type_id: '{{ .Hazard.EventCategoryID }}',
	scat_option_id: '{{ .Hazard.ScatOptionID }}',
	report_by_id: '{{ .Hazard.ReportByID }}',
	location_id: '{{ .Hazard.LocationID }}',
	location_specific: `{{ .Hazard.LocationSpecific }}`,
	event_date: '{{ .Hazard.TanggalWaktu.Format " 2006-01-02T15:04" }}', 
	risk_matrix_id: '{{ .Hazard.RiskMatrixID }}' ,
	consequence_id: '{{ .Hazard.RiskMatrix.RiskConsequenceID }}' ,
	likelihood_id: '{{ .Hazard.RiskMatrix.RiskLikelihoodID }}' ,
	assessment_id: '{{ .Hazard.RiskMatrix.RiskAssessmentID }}' , matrices: {{ json .Matrices }}, consequences: {{ json .Consequences }}, likelihoods: {{ json .Likelihoods }}, assessments: {{ json .Assessments }}, isManualMatrixSelect:
	false, work_type: '{{ .WorkType }}' ,
	department_id: '{{ if .Hazard.DepartmentID }}{{ .Hazard.DepartmentID }}{{ end }}' ,
	contractor_id: '{{ if .Hazard.ContractorID }}{{ .Hazard.ContractorID }}{{ end }}' , pic_id: '{{ .Hazard.PicID }}' ,
	all_pics: {{ json .AllPics }}, all_types: {{ json .AllTypes }},corrective_actions: {{ .CorrectiveActions }}, 
	addCorrectiveAction() {

	// =========================
	// NORMALIZE NULL
	// =========================

	if (!Array.isArray(this.corrective_actions)) {
	this.corrective_actions = []
	}

	this.corrective_actions.push({

	id: '',

	followup_action: '',

	type: 'department',

	department_terkait_id: '',
	contractor_terkait_id: '',

	pic_terkait_id: '',

	due_date: '',
	completed_on: '',

	pics: []

	})

	},
	removeCorrectiveAction(index) { this.corrective_actions.splice(index,
	1) },
	selected_units: [],
	filteredPics: [],

	checkFlash() { const getCookie=(name)=> 
	{
	let value = `; ${document.cookie}`;
	let parts = value.split(`; ${name}=`);
	if (parts.length === 2) return parts.pop().split(';').shift();
	}

	const msg = getCookie('flash_msg');
	const type = getCookie('flash_type');

	if (msg) {
	// Decode pesan agar spasi dan karakter khusus terbaca benar
	const decodedMsg = decodeURIComponent(msg.replace(/\+/g, ' '));

	// Panggil fungsi global showToast dari app.js
	if (window.showToast) {
	window.showToast(decodedMsg, type || 'success');
	}

	// Hapus cookie agar tidak muncul lagi saat refresh manual
	document.cookie = 'flash_msg=; Max-Age=-99999999; path=/;';
	document.cookie = 'flash_type=; Max-Age=-99999999; path=/;';
	}
	},


	// =========================
	// INIT
	// =========================
	async init() {
	console.log(this.report_by_id)
	// =========================
	// PASTIKAN ARRAY
	// =========================
	if (!Array.isArray(this.corrective_actions)) {
	this.corrective_actions = []
	}

	// =========================
	// DEFAULT EMPTY ACTION
	// =========================
	if (
	this.corrective_actions.length === 0 &&
	this.status_area === 'sementara'
	) {

	this.addCorrectiveAction()

	}



	// =========================
	// NORMALIZE ACTIONS
	// =========================
	this.corrective_actions =
	this.corrective_actions.map(item => ({

	...item,

	id: String(item.id || ''),
	type: item.type || 'department',

	department_terkait_id:
	String(item.department_terkait_id || ''),

	contractor_terkait_id:
	String(item.contractor_terkait_id || ''),

	pic_terkait_id:
	String(item.pic_terkait_id || ''),

	due_date: item.due_date || '',
	completed_on: item.completed_on || '',

	// =========================
	// KEEP EXISTING PICS
	// =========================
	pics: (item.pics || []).map(pic => ({

	...pic,

	ID: String(pic.ID || pic.id)

	}))

	}))
	console.log(this.status_area)
	// =========================
	// NORMALIZE STRING VALUES
	// =========================
	this.checkFlash()

	this.event_category_id = String(this.event_category_id || '')
	this.event_type_id = String(this.event_type_id || '')
	this.scat_option_id = String(this.scat_option_id || '')
	this.report_by_id = String(this.report_by_id || '')
	this.location_id = String(this.location_id || '')

	this.department_id = String(this.department_id || '')
	this.contractor_id = String(this.contractor_id || '')
	this.pic_id = String(this.pic_id || '')

	this.consequence_id = String(this.consequence_id || '')
	this.likelihood_id = String(this.likelihood_id || '')
	this.assessment_id = String(this.assessment_id || '')
	this.risk_matrix_id = String(this.risk_matrix_id || '')

	// =========================
	// NORMALIZE ARRAY VALUES
	// =========================
	this.all_types = (this.all_types || []).map(item => ({
	...item,
	ID: String(item.ID)
	}))

	this.all_pics = (this.all_pics || []).map(item => ({
	...item,
	ID: String(item.ID)
	}))

	// =========================
	// VALIDATE EXISTING TYPE
	// =========================
	const selectedType = this.all_types.find(item =>
	String(item.ID) === String(this.event_type_id)
	)

	if (selectedType) {

	this.event_type_id = String(
	selectedType.ID
	)

	}

	// =========================
	// LOAD EVENT TYPES
	// =========================
	if (this.event_category_id) {

	await this.syncData(
	'event_category_id',
	this.event_category_id
	)

	// restore selected type setelah sync
	const syncedType = this.all_types.find(item =>
	String(item.ID) === String(this.event_type_id)
	)

	if (syncedType) {

	this.event_type_id = String(
	syncedType.ID
	)

	}

	}

	// =========================
	// LOAD PICS
	// =========================
	if (
	this.work_type === 'department' &&
	this.department_id
	) {

	await this.syncData(
	'department_id',
	this.department_id
	)

	}

	if (
	this.work_type === 'contractor' &&
	this.contractor_id
	) {

	await this.syncData(
	'contractor_id',
	this.contractor_id
	)

	}

	// =========================
	// INITIAL MATRIX
	// =========================
	this.findMatrix()

	// =========================
	// WATCHERS
	// =========================
	this.$watch('consequence_id', () => {
	this.findMatrix()
	})

	this.$watch('likelihood_id', () => {
	this.findMatrix()
	})

	this.$watch('status_area', (val) => {

	if (
	val === 'sementara' &&
	(!Array.isArray(this.corrective_actions) ||
	this.corrective_actions.length === 0)
	) {

	this.corrective_actions = []

	this.addCorrectiveAction()
	}
	})

	this.$watch('work_type', (value) => {
	this.handleWorkTypeChange(value)
	})

	// =========================
	// RESET TYPE WHEN CATEGORY CHANGES
	// =========================
	this.$watch('event_category_id', (value, oldValue) => {

	if (
	oldValue &&
	value !== oldValue
	) {

	this.event_type_id = ''

	}

	})

	// =========================
	// INITIAL WORK TYPE
	// =========================
	this.handleWorkTypeChange(this.work_type)
	// =========================

	},

	// =========================
	// MATRIX LOGIC
	// =========================
	findMatrix() {

	if (
	!this.consequence_id ||
	!this.likelihood_id
	) {

	this.resetMatrix()
	return

	}

	const matrix = this.matrices.find((item) =>

	String(item.risk_consequence_id) ===
	String(this.consequence_id)

	&&

	String(item.risk_likelihood_id) ===
	String(this.likelihood_id)

	)

	this.risk_matrix_id = String(
	matrix?.id || ''
	)

	this.assessment_id = String(
	matrix?.risk_assessment_id || ''
	)
	},

	resetMatrix() {

	this.risk_matrix_id = ''
	this.assessment_id = ''

	},

	openEdit(
	id,
	consequenceId,
	likelihoodId,
	assessmentId
	) {

	this.risk_matrix_id = String(id || '')
	this.consequence_id = String(consequenceId || '')
	this.likelihood_id = String(likelihoodId || '')
	this.assessment_id = String(assessmentId || '')

	this.$dispatch('field-updated', {
	field: 'consequence_id'
	})

	this.$dispatch('field-updated', {
	field: 'likelihood_id'
	})
	},

	// =========================
	// UI HELPERS
	// =========================
	getConsequenceDesc() {

	const consequence =
	this.consequences.find((item) =>

	String(item.ID) ===
	String(this.consequence_id)

	)

	return consequence?.description || ''
	},

	getLikelihoodNotes() {

	const likelihood =
	this.likelihoods.find((item) =>

	String(item.ID) ===
	String(this.likelihood_id)

	)

	return likelihood?.notes || ''
	},

	getAssessment() {

	return this.assessments.find((item) =>

	String(item.ID) ===
	String(this.assessment_id)

	) || {}
	},

	// =========================
	// WORK TYPE LOGIC
	// =========================
	handleWorkTypeChange(value) {

	if (value === 'department') {

	this.contractor_id = ''
	return

	}

	if (value === 'contractor') {

	this.department_id = ''
	return

	}

	// reset all jika kosong
	this.department_id = ''
	this.contractor_id = ''
	this.pic_id = ''
	this.all_pics = []

	},

	validateCorrectiveActions() {
	let isValid = true

	this.corrective_actions.forEach((action, index) => {
	action.errors = action.errors || {}

	// reset
	action.errors.pic = false
	action.errors.due_date = false

	const isRequired = this.status_area === 'sementara'

	if (isRequired) {
	if (!action.pic_terkait_id) {
	action.errors.pic = true
	isValid = false
	}

	if (!action.due_date) {
	action.errors.due_date = true
	isValid = false
	}
	}
	})

	return isValid
	},



	// =========================
	// FORM SUBMIT
	// =========================
	handleSubmit() {

	const form = this.$refs.form

	if (!form) return

	// =========================
	// RESET ERROR LAMA
	// =========================
	form.querySelectorAll('[data-error]')
	.forEach(el => {
	el.removeAttribute('data-error')
	})

	// =========================
	// TRIGGER VALIDATION
	// =========================
	this.$dispatch('validate-me')

	// tunggu Alpine render
	setTimeout(() => {
	const validCA = this.validateCorrectiveActions()

	if (!validCA) {
	return
	}
	// =========================
	// CEK ERROR CUSTOM
	// =========================
	const invalidFields =
	form.querySelectorAll('[data-error]')

	if (invalidFields.length > 0) {

	invalidFields[0].focus()

	return
	}

	// =========================
	// PREVENT DOUBLE SUBMIT
	// =========================
	if (
	form.dataset.submitting === 'true'
	) {

	return
	}

	form.dataset.submitting = 'true'

	form.submit()

	}, 50)
	},

	// =========================
	// DELETE ACTION
	// =========================
	deleteHazard(id) {
	if (!confirm('Apakah Anda yakin ingin menghapus hazard ini? Aksi ini tidak dapat dibatalkan.')) {
	return;
	}

	fetch('/hazard/delete/' + id, {
	method: 'POST',
	headers: {
	'Content-Type': 'application/json',
	// Jika aplikasi Anda menggunakan CSRF, pastikan menambahkan header ini:
	'X-CSRF-Token': '{{ .CSRFToken }}'
	}
	})
	.then(async response => {
	if (response.ok) {
	window.location.href = '/hazard'; 
	} else {
	// Tangkap pesan error dari JSON yang dikirim Controller
	const data = await response.json().catch(() => ({}));
	const errorMessage = data.error || 'Terjadi kesalahan sistem atau CSRF token tidak valid.';
	alert('Gagal: ' + errorMessage);
	}
	})
	.catch(error => {
	console.error('Error:', error);
	alert('Terjadi kesalahan koneksi.');
	});
	},

	// =========================
	// BACKEND SYNC
	// =========================
	async syncData(name, value, index = null) {

	// =========================
	// GLOBAL STATE ONLY
	// =========================
	if (index === null) {

	this[name] = String(value || '')

	}

	const formData = new FormData()

	formData.append('name', name)
	formData.append('value', String(value || ''))

	try {

	const response = await fetch(
	'/hazards/sync',
	{
	method: 'POST',
	body: formData
	}
	)

	const result = await response.json()

	if (
	result.status !== 'success'
	) {
	return
	}

	// =========================
	// EVENT TYPES
	// =========================
	if (name === 'event_category_id') {

	this.all_types =
	(result.types || []).map(item => ({
	...item,
	ID: String(item.ID)
	}))

	}

	// =========================
	// MAIN PIC
	// =========================
	if (
	name === 'department_id' ||
	name === 'contractor_id'
	) {

	this.all_pics =
	(result.pics || []).map(item => ({
	...item,
	ID: String(item.ID)
	}))

	this.pic_id = ''

	}

	// =========================
	// CORRECTIVE ACTION PICS
	// =========================
	if (
	(
	name === 'department_terkait_id' ||
	name === 'contractor_terkait_id'
	)
	&&
	index !== null
	) {

	this.corrective_actions[index].pics =
	(result.pics_terkait || []).map(item => ({
	...item,
	ID: String(item.ID)
	}))

	// reset selected PIC
	this.corrective_actions[index].pic_terkait_id = ''

	}

	} catch (error) {

	console.error(
	'Sync error:',
	error
	)

	}
	}
	}"
>

	<div class="flex md:flex-row flex-col justify-between px-4">
		<h1 class="text-sm font-bold mb-2 text-base-content uppercase tracking-wider">
			Detail Laporan Hazard
		</h1>
		<!-- You can open the modal using ID.showModal() method -->
		<div class="gap-2 flex items-center mb-2">
			{{ if .CanReopen }}
				<form
					x-ref="reopenForm"
					action="/hazard/update-status/{{ .Hazard.ID }}"
					method="POST">

					<input
						type="hidden"
						name="status"
						x-model="status_laporan">

					<div x-show="isClosed">
						<button
							type="button"
							class="btn btn-xs btn-outline btn-error"

							@click.prevent="
							let hasAction = Array.isArray(corrective_actions) && corrective_actions.length > 0;

							let hasCompleted = hasAction && corrective_actions.every(a => a.completed_on && a.completed_on !== '');

							if (!hasAction) {
							status_laporan = 'submit';
							} 
							else if (!hasCompleted) {
							status_laporan = 'in_progress';
							} 
							else {
							status_laporan = 'in_progress';
							}

							isClosed = false;

							$nextTick(() => {
							$refs.reopenForm.submit()
							})
							">

							{{ lucide "rotate-ccw" (dict "class" "size-4") }}

							Re-open Laporan

						</button>
					</div>

				</form>
			{{ end }}
			<div class="tooltip ">
				<div class="tooltip-content">
					<div class="animate-bounce text-orange-400 -rotate-5 text-xs font-black">Audit Trail</div>
				</div>
				<button class="btn btn-square btn-xs btn-accent " onclick="my_modal_3.showModal()"> {{ lucide "history" (dict "class" "size-4") }}</button>
			</div>
		</div>

	</div>

	<dialog id="my_modal_3" class="modal">

		<div class="modal-box max-w-6xl p-0 overflow-hidden">

			<!-- HEADER -->
			<div class="sticky top-0 z-20 bg-base-100 border-b border-base-300 px-6 py-4">

				<form method="dialog">
					<button
						class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4">
						✕
					</button>
				</form>

				<div>
					<h3 class="text-lg font-bold">
						Audit Trail
					</h3>

					<p class="text-xs opacity-60 mt-1">
						Riwayat perubahan data hazard
					</p>
				</div>

			</div>

			<!-- BODY -->
			<div class="p-5 max-h-[80vh] overflow-y-auto bg-base-200/30">

				{{ if .Audits }}

					<div class="space-y-4">

						{{ range .Audits }}

							<div class="card bg-base-100 border border-base-300 shadow-sm">

								<div class="card-body p-4 space-y-4">

									<!-- TOP INFO -->
									<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">

										<div class="flex items-center gap-3 flex-wrap">

											<div class="badge badge-outline badge-sm">
												{{ .ChangedAt.Format "02 Jan 2006 15:04" }}
											</div>

											<span
												class="badge badge-sm
{{ if eq .Action "CREATE" }}
												badge-success
{{ else if eq .Action "UPDATE" }}
												badge-warning
{{ else if eq .Action "DELETE" }}
												badge-error
{{ else }}
												badge-neutral
{{ end }}">
												{{ .Action }}
											</span>

										</div>

										<div class="text-xs opacity-70">
											By <span class="font-semibold">{{ .User.Name }}</span>
										</div>

									</div>

									<!-- DETAIL -->
									<details class="collapse collapse-arrow border border-base-300 bg-base-100 rounded-xl">

										<summary class="collapse-title text-sm font-semibold min-h-0 py-3 px-4">

											Lihat Perubahan

										</summary>

										<div class="collapse-content px-4 pb-4">

											{{ if and .Before .After }}

												<div class="overflow-x-auto rounded-xl border border-base-300 bg-base-100">

													<div class="min-w-[700px] p-3 text-xs">

														{{ diffJSON .Before .After }}

													</div>

												</div>

											{{ else if .After }}

												<div class="rounded-xl border border-success/30 bg-success/5 overflow-hidden">

													<div class="px-4 py-3 border-b border-success/20 bg-success/10">

														<h4 class="text-xs font-bold tracking-wide text-success">

															CREATED DATA

														</h4>

													</div>

													<div class="overflow-auto max-h-[400px] p-4">

														<pre class="text-[11px] leading-5 whitespace-pre-wrap break-words font-mono text-base-content">{{ prettyJSON .After }}</pre>

													</div>

												</div>

											{{ end }}

										</div>

									</details>

								</div>

							</div>

						{{ end }}

					</div>

				{{ else }}

					<div class="flex flex-col items-center justify-center py-16 text-center">

						<div class="text-base font-semibold opacity-70">
							Belum ada audit trail
						</div>

						<p class="text-xs opacity-50 mt-1">
							Perubahan data akan muncul di sini
						</p>

					</div>

				{{ end }}

			</div>

		</div>

	</dialog>

	{{ template "card_scroll" . }}

</div>

{{ end }}

{{ define "slot" }}



<form x-ref="form" action="/hazard/update/{{ .Hazard.ID }}" method="POST" enctype="multipart/form-data" novalidate
	@submit.prevent="handleSubmit">
	<input type="hidden" name="is_verified" :value="is_verified">
	<input type="hidden" name="is_reopening" value="false">
	<input type="hidden" name="_method" value="PUT">

	<div class="grid grid-cols-1 md:grid-cols-4 gap-2 ">

		<div class="relative " @change="syncData('event_category_id', $event.detail)">

			{{ template "select-search" (dict
				"Label" (index .Tr "ReportType")
				"Name" "event_category_id"
				"ModelName" "event_category_id"
				"Value" .Hazard.EventCategory.ParentID
				"Options" .EventCategories
				"Required" true
				"DefaultText" "-- Pilih Tipe Bahaya --"
				"Placeholder" "Cari tipe bahaya..."
				"DisabledBinding" "isClosed"
				)
			}}

		</div>

		{{ template "select-dynamic" (dict
			"Label" (index .Tr "HazardType")
			"Name" "event_type_id"
			"Model" "event_type_id"
			"Value" .Hazard.EventCategoryID
			"OptionsArray" "all_types"
			"ShowCondition" "event_category_id"
			"DefaultText" "-- Pilih Type --"
			"Required" true
			"DisabledBinding" "isClosed"
			)
		}}

		{{ template "select_input" (dict
			"Label" (index .Tr "HazardCategory")
			"Name" "scat_option_id"
			"ShowType" true
			"Model" "scat_option_id"
			"Placeholder" "Pilih Kategory Bahaya"
			"Options" .ScatOptions
			"Required" true
			"DisabledBinding" "isClosed"
			)
		}}

		<div class="relative my-select-field" @change="location_id = $event.detail">

			{{ template "select-search" (dict "Label" (index .Tr "Location") "Name" "location_id" "ModelName" "location_id" "SearchURL" "/api/locations/search" "Value" .Hazard.LocationID "Options" .Locations "Required" true "DefaultText" "-- Pilih Lokasi --" "Placeholder" "Cari lokasi..." "DisabledBinding" "isClosed") }}

		</div>

		<div x-show="location_id" x-transition>

			{{ template "input" (dict
				"Label" (index .Tr "LocationSpecific")
				"Name" "location_specific"
				"Placeholder" "Isi Lokasi spesifik..."
				"Required" true
				"Attr" "x-model='location_specific'"
				"DisabledBinding" "isClosed"
				)
			}}

		</div>

		<div class="relative ">

			{{ template "select-user-search" (dict
				"Label" (index .Tr "ReporterName")
				"Options" .Users
				"Value" .Hazard.ReportBy.ID
				"SelectedLabel" .Hazard.ReportBy.Name
				"DefaultText" (index .Tr "SelectReporterName")
				"Attr" "x-model='report_by_id'"
				"Required" true
				"DisabledBinding" "isClosed"
				)
			}}

		</div>


		{{ template "input-flatpickr" (dict
			"Label" (index .Tr "DateTimeObservation")
			"Name" "event_date"
			"Id" "event_date"
			"Value" (.Hazard.TanggalWaktu.Format "2006-01-02 15:04")
			"Type" "date-time"
			"Placeholder" (index .Tr "InputDateObservation")
			"Required" true
			"RequiredBinding" ""
			"DisabledBinding" "isClosed"
			"Attr" "x-model=event_date"
			)
		}}
	</div>

	<fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border px-2">

		<legend class="fieldset-legend">
			{{ index .Tr "ResponsibleParty" }}
		</legend>

		<div class="flex flex-col md:flex-row items-center gap-2 ">

			<fieldset class="w-full">

				<input
					id="draft"
					class="peer/draft"
					type="radio"
					value="department"
					name="work_type"
					x-model="work_type"
					:disabled="isClosed"
				/>

				<label
					for="draft"
					:class="isClosed
					? 'opacity-50 cursor-not-allowed'
					: 'peer-checked/draft:text-sky-500'"
					class="text-sm font-semibold text-base-content opacity-60 mb-1">
					{{ index .Tr "Department" }}
				</label>

				<input
					id="published"
					class="peer/published"
					type="radio"
					name="work_type"
					value="contractor"
					x-model="work_type"
					:disabled="isClosed"
				/>

				<label
					for="published"
					:class="isClosed
					? 'opacity-50 cursor-not-allowed'
					: 'peer-checked/published:text-sky-500'"
					class="text-sm font-semibold mb-1 text-base-content opacity-60">
					{{ index .Tr "Contractor" }}
				</label>

				<div class="hidden peer-checked/draft:block  relative"
					@change="syncData('department_id', $event.detail)">

					{{ template "select-search" (dict "Label" "" "Name" "department_id" "ModelName" "department_id" "Value" .Hazard.DepartmentID "Options" .Departments "DefaultText" "-- Pilih Department --" "Placeholder" "Cari department..." "RequiredBinding" "work_type === 'department'" "DisabledBinding" "isClosed") }}

				</div>

				<div class="hidden peer-checked/published:block  relative"
					@change="syncData('contractor_id', $event.detail)">

					{{ template "select-search" (dict "Label" ""
						"Name" "contractor_id" "ModelName"
						"contractor_id" "Value" .Hazard.ContractorID
						"SearchURL" "/api/contracts/search"
						"Options" .Contractors
						"DefaultText" "-- Pilih Contractor --"
						"Attr" "x-model='contractor_id'"
						"RequiredBinding" "work_type === 'contractor'"
						"DisabledBinding" "isClosed"
						)
					}}

				</div>

			</fieldset>

			{{ template "select-dynamic" (dict "Label" (index .Tr "PIC") "Name" "pic_id" "Model" "pic_id" "Value" .Hazard.PicID "OptionsArray" "all_pics" "ShowCondition" "work_type" "DefaultText" (index .Tr "SelectPIC") "Required" true "DisabledBinding" "isClosed") }}
		</div>

	</fieldset>

	{{ $descId := "hazardDescription" }}
	{{ $descLabel := "Deskripsi Bahaya" }}
	{{ $descName := "description" }}
	{{ $descValue := .Hazard.Deskripsi }}

	{{ if eq .Lang "en" }}
		{{ $descId = "hazardDescriptionEn" }}
		{{ $descLabel = "Hazard Description" }}
		{{ $descName = "description_en" }}
		{{ $descValue = .Hazard.DeskripsiEn }}
	{{ end }}

	{{ template "ckeditor" (dict
		"ID" $descId
		"Label" $descLabel
		"Name" $descName
		"AlpineVar" $descId
		"Value" $descValue
		"Required" true
		"DisabledBinding" "isClosed"
		)
	}}

	{{ template "input-file" (dict "Label" (index .Tr "UploadDocument") "DragDropUpload" (index .Tr "DragDropUpload") "Name" "dokumentasi_desc" "Id" "dokumentasi_desc" "Required" true "ExistingFiles" .DescDocs "DisabledBinding" "isClosed") }}
	{{ $actionId := "hazardCorrective_action" }}
	{{ $actionLabel := "Tindakan Perbaikan Langsung" }}
	{{ $actionName := "corrective_action" }}
	{{ $actionValue := .Hazard.CorrectiveAction }}

	{{ if eq .Lang "en" }}
		{{ $actionId = "hazardCorrective_actionEn" }}
		{{ $actionLabel = "Immediate Corrective Action" }}
		{{ $actionName = "corrective_action_en" }}
		{{ $actionValue = .Hazard.CorrectiveActionEn }}
	{{ end }}

	{{ template "ckeditor" (dict
		"ID" $actionId
		"Label" $actionLabel
		"Name" $actionName
		"AlpineVar" $actionId
		"Value" $actionValue
		"Required" true
		"DisabledBinding" "isClosed"
		)
	}}


	{{ template "input-file" (dict "Label" (index .Tr "UploadDocument") "DragDropUpload" (index .Tr "DragDropUpload") "Name" "dokumentasi_corrective" "Id" "dokumentasi_corrective" "Required" true "ExistingFiles" .CorrectiveDocs "DisabledBinding" "isClosed") }}

	<div class="flex flex-col md:flex-row gap-2 ">

		<div class="col-span-2 md:grow">

			{{ template "select_input" (dict "Label" "Consequences" "Name" "consequence_id" "Model" "consequence_id" "Placeholder" "Pilih Consequences" "Class" "max-w-sm" "Options" .Consequences "Required" true "DisabledBinding" "isClosed") }}

			<div x-show="consequence_id" x-transition>

				<textarea :disabled="isClosed" class="textarea textarea-bordered w-full" x-text="getConsequenceDesc()" readonly></textarea>

			</div>

			{{ template "select_input" (dict "Label" "Likelihood" "Name" "likelihood_id" "Model" "likelihood_id" "Placeholder" "Pilih Likelihood" "Class" "max-w-sm" "Options" .Likelihoods "Required" true "DisabledBinding" "isClosed") }}

			<div x-show="likelihood_id" x-transition>

				<textarea :disabled="isClosed" class="textarea textarea-bordered w-full" x-text="getLikelihoodNotes()" readonly></textarea>

			</div>

		</div>

		<div class="md:flex-none">

			<div class="flex flex-col items-center max-w-md ">

				<table class="border-collapse border border-base-300 text-[10px]">

					<caption class="caption-top font-bold text-center bg-base-200 border border-base-300">
						RISK MATRIX GRID
					</caption>

					<thead>
						<tr>
							<th rowspan="2" colspan="2" class="border border-base-300 p-2 bg-base-200 italic">
								Likelihood
							</th>

							<th colspan="5" class="border border-base-300 p-1 bg-base-200">
								Consequence
							</th>

						</tr>

						<tr class="bg-base-200 text-center">

							<th class="border border-base-300 p-1 w-24">
								5-Catastrophic
							</th>

							<th class="border border-base-300 p-1 w-24">
								4-Major
							</th>

							<th class="border border-base-300 p-1 w-24">
								3-Moderate
							</th>

							<th class="border border-base-300 p-1 w-24">
								2-Minor
							</th>

							<th class="border border-base-300 p-1 w-24">
								1-Insignificant
							</th>

						</tr>

					</thead>

					<tbody>

						{{ range $l := .Likelihoods }}

							<tr>

								<td class="border border-base-300 bg-base-200 p-2 font-bold ">
									{{ $l.Sequence }}
								</td>

								<td class="border border-base-300 bg-base-200 p-2 font-medium w-full max-w-xs">
									{{ $l.Name }}
								</td>

								{{ range $c := $.Consequences }}

									{{ $mID := getMatrixID $.Matrices $c.ID $l.ID }}
									{{ $aID := getMatrixAssessmentID $.Matrices $c.ID $l.ID }}

									<td
										class="border border-base-300 text-center font-bold text-base-content uppercase shadow-inner transition-all"

										:class="[
										risk_matrix_id == '{{ $mID }}'
										? 'ring-2 ring-black ring-inset scale-105 z-10'
										: '',

										isClosed
										? 'opacity-60 cursor-not-allowed'
										: 'cursor-pointer hover:opacity-80 hover:scale-[1.02]'
										]"

										style="background-color: {{ getMatrixColor $.Matrices $c.ID $l.ID }};"

										@click="!isClosed && '{{ $mID }}' !== '0' && openEdit(
										'{{ $mID }}',
										'{{ $c.ID }}',
										'{{ $l.ID }}',
										'{{ $aID }}'
										)">

										{{ firstChar (getMatrixName $.Matrices $c.ID $l.ID) }}

										<input
											type="hidden"
											name="risk_matrix_id"
											x-model="risk_matrix_id">

									</td>

								{{ end }}

							</tr>

						{{ end }}

					</tbody>

				</table>

			</div>

		</div>

	</div>

	<div x-show="assessment_id" x-transition class="mt-3 overflow-x-auto">

		<table class="table table-xs table-zebra w-full border border-base-300 rounded-box">

			<tbody>

				<tr>

					<td class="font-semibold w-40">
						Assessment
					</td>

					<td>

						<span class="font-bold" x-text="getAssessment().name || '-'"></span>

					</td>

				</tr>

				<tr>

					<td class="font-semibold">
						Notes
					</td>

					<td>

						<div class="whitespace-pre-line text-sm" x-text="getAssessment().notes || '-'"></div>

					</td>

				</tr>

				<tr>

					<td class="font-semibold">
						Investigation Required
					</td>

					<td>

						<div class="whitespace-pre-line text-sm" x-text="getAssessment().investigation_reqd || '-'">
						</div>

					</td>

				</tr>

				<tr>

					<td class="font-semibold">
						Reporting Obligation
					</td>

					<td>

						<span x-text="getAssessment().reporting_obligation || '-'"></span>

					</td>

				</tr>

			</tbody>

		</table>

	</div>

	<div class="mt-4 p-4 bg-base-100 rounded-xl border border-base-300">
		<h2 class="text-sm font-bold mb-3 flex items-center gap-2">
			<span class="bg-primary/10 p-1 rounded-lg">
				{{ lucide "activity" (dict "class" "size-4 text-primary") }}
			</span>
			{{ index .Tr "CurrentAreaStatus" }}
		</h2>

		<!-- WRAPPER VALIDATION -->
		<div x-ref="statusAreaWrapper" class="space-y-2">

			<!-- RADIO GROUP -->
			<div
				class="grid grid-cols-1 md:grid-cols-2 gap-3 p-2 rounded-xl transition-all duration-200"
				:class="[
				status_area_error
				? 'border-2 border-error bg-error/5'
				: 'border border-transparent',

				isClosed
				? 'opacity-60 pointer-events-none'
				: ''
				]">

				<!-- Opsi 1: Aman Total -->
				<label
					class="flex items-center justify-between p-3 rounded-xl border transition-all duration-200"
					:class="[
					status_area === 'aman'
					? 'bg-success/10 border-success shadow-sm'
					: 'bg-base-200 border-transparent',

					isClosed
					? 'cursor-not-allowed'
					: 'cursor-pointer'
					]">

					<div class="flex items-center gap-3">

						<span class="text-xl">✅</span>

						<div>

							<p
								class="font-bold text-sm"
								:class="status_area === 'aman'
								? 'text-success'
								: ''">

								{{ index .Tr "FullySecured" }}

							</p>

							<p class="text-[10px] opacity-60 italic">
								{{ index .Tr "ResolvedOnSite" }}
							</p>

						</div>

					</div>

					<input
						type="radio"
						name="status_area"
						value="aman"

						x-model="status_area"

						:disabled="isClosed"

						@change="status_area_error = false"

						class="radio radio-success radio-sm" />

				</label>

				<!-- Opsi 2: Aman Sementara -->
				<label
					class="flex items-center justify-between p-3 rounded-xl border transition-all duration-200"
					:class="[
					status_area === 'sementara'
					? 'bg-warning/10 border-warning shadow-sm'
					: 'bg-base-200 border-transparent',

					isClosed
					? 'cursor-not-allowed'
					: 'cursor-pointer'
					]">

					<div class="flex items-center gap-3">

						<span class="text-xl">⚠️</span>

						<div>

							<p
								class="font-bold text-sm"
								:class="status_area === 'sementara'
								? 'text-warning'
								: ''">

								{{ index .Tr "TemporarilySecured" }}

							</p>

							<p class="text-[10px] opacity-60 italic">
								{{ index .Tr "FurtherActionRequired" }}
							</p>

						</div>

					</div>

					<input
						type="radio"
						name="status_area"
						value="sementara"

						x-model="status_area"

						:disabled="isClosed"

						@change="status_area_error = false"

						class="radio radio-warning radio-sm" />

				</label>

			</div>

			<!-- ERROR MESSAGE -->
			<p x-show="status_area_error" x-transition class="text-error text-xs font-semibold">
				{{ index .Tr "SelectAreaStatusFirst" }}
			</p>
		</div>

		<!-- Field Lanjutan -->
		<div x-show="status_area === 'sementara'" x-transition
			class="mt-4 space-y-4 pt-3 border-t border-dashed border-base-300">

			<!-- HEADER -->
			<div class="flex justify-between items-center">

				<h3 class="font-bold text-sm">
					{{ index .Tr "CorrectiveActionFollowUp" }}
				</h3>

				<button type="button" class="btn btn-primary btn-sm" @click="addCorrectiveAction()">

					{{ index .Tr "AddAction" }}

				</button>

			</div>

			<!-- LOOP -->
			<template x-for="(action, index) in corrective_actions" :key="index">

				<div class="border border-base-300 rounded-xl p-4 space-y-3">
					<input type="hidden" name="type[]" :value="action.type">
					<!-- ACTION HEADER -->
					<div class="flex justify-between items-center">

						<h4 class="font-semibold text-sm">
							Action #<span x-text="index + 1"></span>
						</h4>

						<button type="button" class="btn btn-error btn-xs" @click="removeCorrectiveAction(index)">

							{{ index .Tr "Delete" }}

						</button>

					</div>

					<!-- FOLLOWUP -->
					<div>
						{{ template "ckeditor-loop" (dict "Label" (index .Tr "Delete") "Name" "followup_action[]" "ID" "`followup_${index}`" "AlpineVar" "action.followup_action" "RequiredBinding" "status_area === 'sementara'") }}
					</div>

					<!-- TYPE -->
					<fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border px-2">

						<legend class="fieldset-legend">
							{{ index .Tr "TargetDeptContractor" }}
						</legend>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
							<div>
								<div class="flex gap-4 ">

									<label class="label cursor-pointer gap-2">

										<input type="radio" value="department" x-model="action.type" @change="
											action.department_terkait_id = ''
											action.pic_terkait_id = ''
											action.pics = []
											" :name="`corrective_action_type_${index}`" class="radio radio-xs" />

										<span class="label-text">
											{{ index .Tr "Department" }}
										</span>

									</label>

									<label class="label cursor-pointer gap-2">

										<input type="radio" value="contractor" x-model="action.type" @change="
											action.contractor_terkait_id = ''
											action.pic_terkait_id = ''
											action.pics = []
											" :name="`corrective_action_type_${index}`" class="radio radio-xs" />

										<span class="label-text">
											{{ index .Tr "Contractor" }}
										</span>

									</label>

								</div>

								<div x-show="action.type === 'department'" @change="
									syncData(
									'department_terkait_id',
									$event.detail,
									index
									)
									">

									{{ template "select-search-loop" (dict "Name" "department_terkait_id[]" "Placeholder" (index .Tr "SearchDept") "DefaultText" (index .Tr "SelectDepartment") "AlpineVar" "action.department_terkait_id" "Options" $.Departments "RequiredBinding" "status_area === 'sementara' && action.type=== 'department'" "Attr" "@change=\"syncData('department_terkait_id', action.department_terkait_id, index)\"") }}

								</div>

								<!-- CONTRACTOR -->
								<div x-show="action.type === 'contractor'" @change="
									syncData(
									'contractor_terkait_id',
									$event.detail,
									index
									)
									">

									{{ template "select-search-loop" (dict "Name" "contractor_terkait_id[]" "Placeholder" (index .Tr "SearchContractor") "DefaultText" (index .Tr "SelectContractor") "AlpineVar" "action.contractor_terkait_id" "Options" $.Contractors "RequiredBinding" "status_area === 'sementara' && action.type=== 'contractor'" "Attr" "@change=\"syncData('contractor_terkait_id', action.contractor_terkait_id, index)\"") }}

								</div>
							</div>
							<!-- PIC -->
							<div>
								<label class="label mb-0.5">
									<span class="text-xs font-bold text-base-content opacity-60">
										{{ index .Tr "PIC" }}
										<span class="text-error font-bold ml-0.5">*</span>
									</span>

								</label>
								<select
									class="select select-bordered select-xs w-full focus:outline-none leading-normal focus:ring-0 appearance-none"
									:class="action.errors?.pic ? 'border-error text-error' : ''"
									:name="`pic_terkait_id[]`" @change="
									action.pic_terkait_id =
									$event.target.value
									">

									<option value="">
										{{ index .Tr "SelectPIC" }}
									</option>

									<template x-for="pic in action.pics" :key="pic.ID">

										<option :value="String(pic.ID)" :selected="
											String(action.pic_terkait_id)
											===
											String(pic.ID)
											" x-text="pic.name">
										</option>

									</template>

								</select>
								<template x-if="action.errors?.pic">
									<p class="text-error text-[10px] mt-1 font-semibold">
										{{ index .Tr "PicRequired" }}
									</p>
								</template>
							</div>
							<!-- DUE DATE -->
							<div>

								<label class="label mb-0.5">
									<span class="text-xs font-bold text-base-content opacity-60">
										Due Date
									</span>
								</label>
								<input type="date" @click="$el.showPicker()"
									class="input input-bordered input-xs w-full focus:outline-none focus:border-info focus:ring-info"
									:class="action.errors?.due_date ? 'border-error' : ''"
									:name="`due_date[]`" x-model="action.due_date">
								<template x-if="action.errors?.due_date">
									<p class="text-error text-[10px] mt-1 font-semibold">
										{{ index .Tr "DueDateRequired" }}
									</p>
								</template>

							</div>

							<!-- COMPLETED -->
							<div>
								<label class="label mb-0.5">
									<span class="text-xs font-bold text-base-content opacity-60">
										Completed On
									</span>
								</label>


								<input type="date" @click="$el.showPicker()"
									class="input input-bordered input-xs w-full focus:outline-none focus:border-info focus:ring-info"
									:name="`completed_on[]`" x-model="action.completed_on">

							</div>
						</div>
					</fieldset>
				</div>
			</template>

		</div>
	</div>

	{{ $hasComment := ne .Hazard.ModeratorComment "" }}
	{{ $isModerator := .IsModerator }} 

	{{ $disabledExpr := "true" }} 
	{{ if $isModerator }}
		{{ $disabledExpr = "isClosed" }} 
	{{ end }}

	{{ if or $hasComment $isModerator }}
		<div class="mt-4 p-4 bg-base-200/50 rounded-xl border border-base-300">
			<label class="label mb-1 px-0">
				<span class="text-sm font-bold flex items-center gap-2">
					<span class="bg-warning/10 p-1 rounded-lg">
						{{ lucide "message-square" (dict "class" "size-4 text-warning") }}
					</span>
					{{ index .Tr "AuditorNotes" }}
				</span>
			</label>

			{{ $modId := "hazardModerator_comment" }}
			{{ $modLabel := "Komentar Moderator" }}
			{{ $modName := "moderator_comment" }}
			{{ $modValue := .Hazard.ModeratorComment }}

			{{ if eq .Lang "en" }}
				{{ $modId = "hazardModerator_commentEn" }}
				{{ $modLabel = "Moderator Comment" }}
				{{ $modName = "moderator_comment_en" }}
				{{ $modValue = .Hazard.ModeratorCommentEn }}
			{{ end }}

			{{ template "ckeditor" (dict
				"ID" $modId
				"Label" $modLabel
				"Name" $modName
				"AlpineVar" $modId
				"Value" $modValue
				"Required" false
				"DisabledBinding" "isClosed"
				)
			}}

			{{ if $isModerator }}
				<p class="text-[10px] opacity-60 mt-1.5 italic flex items-start gap-1">
					{{ lucide "info" (dict "class" "size-3 mt-0.5 shrink-0") }}
					{{ index .Tr "OptionalInfo" }}
				</p>
			{{ else }}
				<p class="text-[10px] mt-1.5 text-warning font-semibold italic flex items-start gap-1">
					{{ lucide "alert-circle" (dict "class" "size-3 mt-0.5 shrink-0") }}
					{{ index .Tr "CompleteInstruction" }}
				</p>
			{{ end }}
		</div>
	{{ end }}
	<div class="justify-self-end w-full max-w-md flex flex-col md:flex-row gap-2 mt-4">

		<!-- Tombol 1: Simpan/Update Data Biasa (Mengubah status ke In Progress / Pending otomatis di Go) -->
		<button type="button" @click="is_verified = 'false';  handleSubmit()" class="btn btn-warning btn-sm px-6 flex-1" :disabled="isClosed">
			{{ lucide "save" (dict "class" "size-4") }}
			{{ index .Tr "UpdateHazard" }}
		</button>

		<!-- Tombol 2: Hanya Muncul Jika Status Saat Ini 'pending' (Menunggu Verifikasi Auditor) -->
		{{ if eq .Hazard.Status "pending" }}
			<button type="button" @click="is_verified = 'true'; handleSubmit()" class="btn btn-success btn-sm px-6 flex-1 text-white" :disabled="isClosed">
				{{ lucide "check-circle" (dict "class" "size-4") }}
				{{ index .Tr "VerifyClose" }}
			</button>
		{{ end }}
		{{ if .IsModerator }}

			<button type="button" class="btn btn-error btn-sm px-6" @click="deleteHazard('{{ .Hazard.ID }}')" :disabled="isClosed">
				{{ lucide "trash-2" (dict "class" "size-4") }}
				{{ index .Tr "Delete" }}
			</button>

		{{ end }}

	</div>

</form>

{{ end }}