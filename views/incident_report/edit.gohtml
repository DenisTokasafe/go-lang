{{ define "title" }}Buat Laporan Insiden - SENTRY{{ end }}
{{ define "content" }}
<div class="px-4 w-full " 
	x-data="{
	stripHtml(html) {
	let tmp = document.createElement('DIV');
	tmp.innerHTML = html;
	return tmp.textContent || tmp.innerText || '';
	},
	checkValidate:false,
	isSubmitting: false,
	showErrors: false,
	activeTab: 1, totalTabs: 9,
	incident: {{ json .Incident }},
	all_scat_options: {{ json .ScatOptionsAll }},

	// Data list (array dari database)
	server_causes: {{ .GroupedCauses }},
	causes: {
	unsafe_condition: [],
	unsafe_act: [],
	personal_factor: [],
	job_factor: [],
	control_system: []
	},
	// =========================
	// BASIC STATE
	// =========================
	type_error: false,
	status: 'submit', // Status default saat create

	// State khusus untuk CKEditor / Rich Text
	TaskPerformed: '',
	IncidentDescription: '',
	ImmediateAction: '',
	DamageDetail: '',
	KeyLearning: '',

	dokumentasi_desc: [],

	// =========================
	// EVENT DATA
	// =========================
	event_category_id: '',
	event_type_id: '',
	scat_option_id: '',

	location_id: '{{ .Data.LocationID }}',
	location_specific: '',
	event_date: '',
	reporter_id: '{{ .AuthUser.ID }}',

	// =========================
	// RISK MATRIX
	// =========================
	risk_matrix_id: '',
	consequence_id: '',
	likelihood_id: '',
	assessment_id: '',

	matrices: {{ json .Matrices }},
	consequences: {{ json .Consequences }},
	likelihoods: {{ json .Likelihoods }},
	assessments: {{ json .Assessments }},

	isManualMatrixSelect: false,

	// =========================
	// PIC & WORK TYPE (Bagian 1)
	// =========================
	work_type: 'department',
	department_id: '',
	contractor_id: '',
	pic_id: '',
	all_pics: [],
	all_types: [],

	// =========================
	// NEW: STATE BAGIAN 2 (Pihak Terlibat Langsung)
	// =========================

	involved_parties: [
	{
	user_id: null,
	reporter_manual: '',
	work_type: 'department', // 'department' atau 'contractor'
	department_id: '',
	contractor_id: '',
	jabatan: '',
	roster: '',
	shift: 'Day',
	keterlibatan: '',
	pengalaman: 0
	}
	],
	involved_error: false,
	// =========================
	// STATE BAGIAN 3 (Tim Investigasi)
	// =========================
	investigators: [
	{ 
	role: 'Pemimpin Investigasi', 
	employee_id: '', 
	jabatan: '', 
	work_type: 'department', // Default internal
	department_id: '', 
	contractor_id: '' 
	},
	{ 
	role: 'Facilitator', 
	employee_id: '', 
	jabatan: '', 
	work_type: 'department', 
	department_id: '', 
	contractor_id: '' 
	},
	{ 
	role: 'Anggota', 
	employee_id: '', 
	jabatan: '', 
	work_type: 'department', 
	department_id: '', 
	contractor_id: '' 
	}
	],
	investigator_error: false,
	// Logika Tambah Baris
	addInvestigator(roleType) {
	this.investigators.push({
	role: roleType,
	employee_id: '',
	jabatan: '',
	work_type: 'department',
	department_id: '',
	contractor_id: ''
	});
	this.investigator_error=false;
	},

	removeInvestigator(index) {
	this.investigators.splice(index, 1);
	},
	// =========================
	// NEW: LOGIK BAGIAN 2
	// =========================
	addInvolvedParty() {
	this.involved_parties.push({
	user_id: '',
	reporter_manual: '',
	work_type: 'department',
	department_id: '',
	contractor_id: '',
	jabatan: '',
	roster: '',
	shift: 'Day',
	keterlibatan: '',
	pengalaman: 0
	});
	this.involved_error = false;
	},

	removeInvolvedParty(index) {
	this.involved_parties.splice(index, 1);
	},

	peepo_factors: [
	{ factor: 'Orang', findings: '', description: '' },
	{ factor: 'Peralatan', findings: '', description: '' },
	{ factor: 'Lingkungan', findings: '', description: '' },
	{ factor: 'Prosedur', findings: '', description: '' },
	{ factor: 'Organisasi', findings: '', description: '' }
	],
	addFactor() {
	this.peepo_factors.push({ factor: 'Orang', findings: '', description: '' });
	},

	removeFactor(index) {
	if (this.peepo_factors.length > 1) {
	this.peepo_factors.splice(index, 1);
	} else {
	alert('Minimal harus ada 1 faktor');
	}
	},

	initTimelines() {
	if (this.incident && this.incident.timelines && this.incident.timelines.length > 0) {
	this.timelines = this.incident.timelines.map((t) => {
	// Cek apakah data sudah dalam format baru (JSONB)
	let processedWhys = [];

	if (t.whys && Array.isArray(t.whys)) {
	// Jika sudah ada 'whys' (dari DB JSONB), gunakan langsung
	processedWhys = t.whys;
	} else {
	// Jika masih data lama (flat), lakukan migrasi ke format baru
	processedWhys = [
	{ text: t.why1 || '', children: [] },
	{ text: t.why2 || '', children: [] },
	{ text: t.why3 || '', children: [] },
	{ text: t.why4 || '', children: [] },
	{ text: t.why5 || '', children: [] }
	].filter(w => w.text !== '');
	}

	return {
	event: t.event || '',
	// Pastikan minimal ada 1 input kosong jika array kosong
	whys: processedWhys.length > 0 ? processedWhys : [{ text: '', children: [] }]
	};
	});
	} else {
	// Fallback jika tidak ada timeline sama sekali (data baru)
	this.timelines = [{
	event: (this.incident && this.incident.deskripsi) ? this.incident.deskripsi : '',
	whys: [{ text: '', children: [] }]
	}];
	}
	},

	addWhy(timelineIndex) {
	this.timelines[timelineIndex].whys.push({ text: '', children: [] });
	},
	removeWhy(timelineIndex, whyIndex) {
	this.timelines[timelineIndex].whys.splice(whyIndex, 1);
	},
	addChildWhy(timelineIndex, whyIndex) {
	this.timelines[timelineIndex].whys[whyIndex].children.push({ text: '' });
	},
	removeChildWhy(timelineIndex, whyIndex, childIndex) {
	this.timelines[timelineIndex].whys[whyIndex].children.splice(childIndex, 1);
	},

	addCauseRow(type) {
	// Karena di template Anda menggunakan type + 's' (e.g., unsafe_conditions)
	// Kita panggil key yang sesuai
	const key = type + 's'; 
	this.causes[key].push({
	category_type: type,
	scat_option_id: '',
	description: ''
	});
	},

	// Fungsi menghapus baris
	removeCauseRow(type, index) {
	const key = type + 's';
	if (this.causes[key].length > 0) {
	this.causes[key].splice(index, 1);
	}
	},

	corrective_actions: [
	{
	action: '',
	control_hierarchy: '',
	user_id: '', 
	due_date: ''
	}
	],
	addCorrectiveAction() {
	this.corrective_actions.push({
	action: '',
	control_hierarchy: '',
	user_id: '', 
	due_date: ''
	});
	},

	// Fungsi untuk menghapus baris berdasarkan index
	removeCorrectiveAction(index) {
	this.corrective_actions.splice(index, 1);
	},

	// Contoh di dalam x-data utama form
	validateAndJump() {
	// Daftar tab yang ingin dicek
	const tabs = [
	{ id: 1, ref: 'tab1' },
	{ id: 2, ref: 'tab2' },
	{ id: 3, ref: 'tab3' },
	{ id: 4, ref: 'tab4' },
	{ id: 5, ref: 'tab5' },
	{ id: 6, ref: 'tab6' },
	{ id: 7, ref: 'tab7' },
	{ id: 8, ref: 'tab8' },
	{ id: 9, ref: 'tab9' }
	];

	for (const tab of tabs) {
	// Cari container tab tersebut
	const container = this.$refs[tab.ref];
	if (!container) continue;

	// Cari semua textarea yang required dan kosong di dalam tab ini
	const invalidInputs = container.querySelectorAll('input[required]:not([type=\'hidden\']), select[required], textarea[required]');

	for (const input of invalidInputs) {
	// Cek apakah input kosong
	if (!input.value.trim()) {
	// 1. Buka Tab yang bersangkutan
	this.activeTab = tab.id;

	// 2. Trigger validasi pada komponen tersebut (jika ada fungsi validasi)
	// Kita dispatch event agar komponen textarea menangkapnya
	input.dispatchEvent(new Event('input')); // Memaksa update state isInvalid

	// 3. Tunggu tab terbuka, baru scroll
	this.$nextTick(() => {
	input.scrollIntoView({ behavior: 'smooth', block: 'center' });
	input.focus();
	});

	return false; // Berhenti di error pertama
	}
	}
	}
	return true; // Jika semua valid
	},// COLSE

	checkFlash() {
	const getCookie = (name) => {
	let value = `; ${document.cookie}`;
	let parts = value.split(`; ${name}=`);
	if (parts.length === 2) return parts.pop().split(';').shift();
	}

	const msg = getCookie('flash_msg');
	const type = getCookie('flash_type');

	if (msg) {
	const decodedMsg = decodeURIComponent(msg.replace(/\+/g, ' '));
	if (window.showToast) {
	window.showToast(decodedMsg, type || 'success');
	}
	document.cookie = 'flash_msg=; Max-Age=-99999999; path=/;';
	document.cookie = 'flash_type=; Max-Age=-99999999; path=/;';
	}
	},
	doc: {{ json .Docs }},



	getScatOptions(categoryType) {
	// 1. Pastikan data tersedia
	if (!this.all_scat_options) return [];
	// 2. Gunakan toLowerCase agar tidak sensitif terhadap huruf besar/kecil
	const targetType = categoryType.toLowerCase();
	return this.all_scat_options.filter(opt => {
	return opt.type && opt.type.toLowerCase() === targetType; 
	});
	},

	reviewerConfigs: [
	{ key: 'pm', title: 'Penerimaan & Komentar Project Manager: (Jika kontraktor)' },
	{ key: 'dept', title: 'Penerimaan & Komentar Dept Penanggung Jawab:' },
	{ key: 'ohs', title: 'Penerimaan & Komentar OHS Dept Head:' },
	{ key: 'dirops', title: 'Penerimaan & Komentar Direktur Operasi: (Hanya untuk insiden dengan aktual Level 3,4,5)' },
	{ key: 'ktt', title: 'Penerimaan & Komentar KTT: (Hanya untuk insiden dengan aktual Level 3,4,5)' }
	],


	reviews: {
	pm: { comment: '', user_id: '', accepted: null },
	dept: { comment: '', user_id: '', accepted: null },
	ohs: { comment: '', user_id: '', accepted: null },
	dirops: { comment: '', user_id: '', accepted: null },
	ktt: { comment: '', user_id: '', accepted: null }
	},

	// ... state Alpine Anda yang lain (reviewerConfigs, reviews, dll)
	isReviewVisible(key) {
	// Skenario 1: Jika contractor_id null, sembunyikan 'pm'
	if (key === 'pm' && (!this.incident.contractor_id || this.incident.contractor_id === '')) {
	return false;
	}

	// Skenario 2: Jika consequence level < 3, sembunyikan 'dirops' dan 'ktt'
	if ((key === 'dirops' || key === 'ktt') && this.getConsequenceLevel() < 3) {
	return false;
	}

	// Default: Tampilkan semua step lainnya
	return true;
	},
	// 1. Fungsi untuk mengecek apakah satu blok reviewer sudah diisi lengkap
	isReviewComplete(key) {
	const review = this.reviews[key];

	// 1. Pastikan object review ada
	if (!review) return false;

	// 2. Cek apakah komentar sudah diisi (bukan string kosong / hanya spasi)
	const isCommentValid = Boolean(review.comment && review.comment.trim() !== '');

	// 3. Cek apakah peninjau (user_id) sudah dipilih
	const isUserValid = review.user_id !== null && review.user_id !== '' && review.user_id !== 0;

	// 4. Cek apakah status penerimaan sudah dipilih (harus boolean murni true atau false, bukan null)
	const isAcceptedValid = review.accepted !== null && review.accepted !== '';

	// Kembalikan true HANYA JIKA ketiganya sudah valid
	return isCommentValid && isUserValid && isAcceptedValid;
	},
	isDataInDatabase(key) {
	// Pastikan review ada, dan memiliki user_id (atau field lain yang menandakan data sudah masuk)
	const review = this.reviews[key];
	return review && review.user_id !== '' && review.user_id !== null && review.accepted !== null;
	},
	isSavedInDatabase(key) {
	const review = this.reviews[key];
	// Sesuaikan kondisi ini dengan field unik di database Anda.
	// Contoh: jika ada ID, berarti sudah tersimpan.
	return review && review.id !== null && review.id !== undefined && review.id > 0;
	},

	// 2. Fungsi untuk menentukan apakah blok saat ini boleh dibuka
	isReviewUnblocked(currentIndex) {
	// 1. PM (index 0) selalu terbuka
	if (currentIndex === 0) return true;

	// 2. Ambil key sebelumnya
	const prevKey = this.reviewerConfigs[currentIndex - 1].key;

	// 3. LOGIKA TAMBAHAN: 
	// Jika langkah sebelumnya disembunyikan (skipped), 
	// maka langkah ini otomatis terbuka (tidak perlu menunggu yang sebelumnya)
	if (!this.isReviewVisible(prevKey)) {
	return true;
	}

	// 4. Jika langkah sebelumnya muncul, maka WAJIB menunggu data tersimpan
	return this.isDataInDatabase(prevKey);
	},
	// Fungsi penentu apakah form di dalam blok ini WAJIB diisi saat ini
	isReviewRequired(key) {
	// 0. Jika blok tidak terlihat, abaikan (otomatis skip blok yang tidak relevan)
	if (!this.isReviewVisible(key)) return false;

	// 1. TENTUKAN SIAPA YANG SEDANG BERTUGAS (Aktif)
	// Cari blok pertama yang BELUM TERSIMPAN di database
	// dan dipastikan blok tersebut memang VISIBLE (terlihat).
	const activeReviewer = this.reviewerConfigs.find(r => 
	this.isReviewVisible(r.key) && !this.isSavedInDatabase(r.key)
	);

	// 2. Jika blok yang sedang dicek adalah blok yang sedang bertugas (active),
	// maka WAJIB diisi.
	if (activeReviewer && activeReviewer.key === key) {
	return true;
	}

	// 3. Jika blok sudah tersimpan (selesai) atau belum gilirannya, 
	// kembalikan FALSE (Tidak wajib).
	return false;
	},

	// =========================
	// INIT (OPTIMIZED FOR PERFORMANCE)
	// =========================
	async init() {
	// -----------------------------------------------------------------
	// BAGIAN 1: PRIORITAS UTAMA (Langsung dieksekusi agar UI awal segera muncul)
	// -----------------------------------------------------------------
	this.checkFlash();
	this.initTimelines();

	this.event_category_id = this.incident.EventCategory ? String(this.incident.EventCategory.parent_id) : '';
	this.event_type_id = this.incident.event_category_id ? String(this.incident.event_category_id) : '';
	this.scat_option_id = this.incident.scat_option_id;
	this.location_id = this.incident.location_id;
	this.location_specific = this.incident.location_specific;
	this.department_id = this.incident.department_id;
	this.contractor_id = this.incident.contractor_id;
	this.event_date = this.incident.tanggal_waktu;
	this.consequence_id = this.incident.RiskMatrix.risk_consequence_id;
	this.likelihood_id = this.incident.RiskMatrix.risk_likelihood_id;
	this.assessment_id = this.incident.RiskMatrix.risk_assessment_id;
	this.risk_matrix_id = this.incident.risk_matrix_id;

	this.pic_id = this.incident.pic_id;
	this.IncidentDescription = this.incident.deskripsi || '';
	this.TaskPerformed = this.incident.tugas_dijalankan || '';
	this.ImmediateAction = this.incident.tindakan_langsung || '';
	this.DamageDetail = this.incident.detil_kerusakan_kerugian || '';
	this.KeyLearning = this.incident.key_learning || '';
	// Watch matrix dependency & work type
	this.$watch('consequence_id', () => this.findMatrix());
	this.$watch('likelihood_id', () => this.findMatrix());

	this.handleWorkTypeChange(this.work_type);
	this.$watch('work_type', (value) => {
	this.handleWorkTypeChange(value);
	});

	// Memicu browser melakukan render UI dasar pertama kali (Mengurangi TBT)
	await new Promise(resolve => setTimeout(resolve, 0));

	// -----------------------------------------------------------------
	// BAGIAN 2: PROSES DATA PENYEBAB (CAUSES) & SYNC EVENT
	// -----------------------------------------------------------------
	const keyMap = {
	'unsafe_condition': 'unsafe_condition',
	'unsafe_act': 'unsafe_act',
	'personal_factor': 'personal_factor',
	'job_factor': 'job_factor',
	'control_system': 'control_system'
	};

	Object.keys(this.causes).forEach(key => {
	const serverKey = keyMap[key];
	if (this.server_causes[serverKey] && this.server_causes[serverKey].length > 0) {
	this.causes[key] = this.server_causes[serverKey].map(item => {
	return {
	...item,
	scat_option_id: item.scat_option_id ? Number(item.scat_option_id) : ''
	};
	});
	} else {
	this.causes[key] = [{ 
	category_type: key, 
	scat_option_id: '', 
	description: '' 
	}];
	}
	});

	if (this.event_category_id) {
	await this.syncData('event_category_id', this.event_category_id, true);
	const syncedType = this.all_types.find(item => String(item.ID) === String(this.event_type_id));
	if (syncedType) {
	this.event_type_id = String(syncedType.ID);
	}
	}

	this.$watch('event_category_id', (value, oldValue) => {
	if (oldValue && value !== oldValue) {
	this.event_type_id = '';
	}
	});

	// Istirahat sejenak untuk memotong Long Task JS berikutnya
	await new Promise(resolve => setTimeout(resolve, 0));

	// -----------------------------------------------------------------
	// BAGIAN 3: PROSES DATA PERSONEL (PICS) & KARYAWAN
	// -----------------------------------------------------------------
	this.all_pics = {{ json .AllPics }};
	const match = this.all_pics.find(item => String(item.ID) === String(this.incident.pic_id));

	if (this.work_type === 'department' && this.department_id) {
	await this.syncData('department_id', this.department_id);
	}

	if (this.work_type === 'contractor' && this.contractor_id) {
	await this.syncData('contractor_id', this.contractor_id);
	}

	if (match) {
	this.pic_id = String(match.ID);
	}

	// Istirahat sejenak sebelum memproses array pemetaan yang besar
	await new Promise(resolve => setTimeout(resolve, 0));

	// -----------------------------------------------------------------
	// BAGIAN 4: PROSES PIHAK TERLIBAT & INVESTIGATOR
	// -----------------------------------------------------------------
	if (this.incident && this.incident.pihak_terlibat && this.incident.pihak_terlibat.length > 0) {
	this.involved_parties = this.incident.pihak_terlibat.map(party => {
	let currentWorkType = '';
	if (party.department_id !== null && party.department_id > 0) {
	currentWorkType = 'department';
	} else if (party.contractor_id !== null && party.contractor_id > 0) {
	currentWorkType = 'contractor';
	}

	return {
	user_id: party.user_id || '',
	work_type: currentWorkType, 
	department_id: party.department_id || '',
	contractor_id: party.contractor_id || '',
	jabatan: party.jabatan || '',
	roster: party.roster || '',
	shift: party.shift || '',
	keterlibatan: party.keterlibatan || '',
	pengalaman: party.pengalaman || 0
	};
	});
	} else {
	this.involved_parties = [
	{
	user_id: null,
	work_type: 'department', 
	department_id: '',
	contractor_id: '',
	jabatan: '',
	roster: '',
	shift: 'Day',
	keterlibatan: '',
	pengalaman: 0
	}
	]; 
	}

	if (this.incident && this.incident.investigation_participants && this.incident.investigation_participants.length > 0) {
	this.investigators = this.incident.investigation_participants.map((inv, idx) => {
	let currentWorkType = 'department'; 
	if (inv.contractor_id !== null && inv.contractor_id > 0) {
	currentWorkType = 'contractor';
	}
	return {
	id_existing: 'existing-' + idx,
	role: inv.role || '',
	employee_id: inv.employee_id || '',
	jabatan: inv.jabatan || '',
	work_type: currentWorkType, 
	department_id: inv.department_id || '',
	contractor_id: inv.contractor_id || ''
	};
	});
	} else {
	this.investigators = [
	{
	id_existing: 'new-' + Date.now(),
	role: '',
	employee_id: null,
	jabatan: '',
	work_type: 'department',
	department_id: '',
	contractor_id: ''
	}
	];
	}

	// Istirahat terakhir untuk sisa pemetaan form belakang
	await new Promise(resolve => setTimeout(resolve, 0));

	// -----------------------------------------------------------------
	// BAGIAN 5: PROSES PEEPO FACTORS, CORRECTIVE ACTIONS & REVIEWS
	// -----------------------------------------------------------------
	if (this.incident.peepo_factors && this.incident.peepo_factors.length > 0) {
	this.peepo_factors = this.incident.peepo_factors;
	}

	if (this.incident && this.incident.corrective_action_incidents && this.incident.corrective_action_incidents.length > 0) {
	this.corrective_actions = this.incident.corrective_action_incidents.map((act, idx) => {
	return {
	key_id: 'existing-' + idx,
	action: act.action,
	control_hierarchy: act.control_hierarchy,
	user_id: act.user_id || null, 
	due_date: act.due_date
	};
	});
	} else {
	this.corrective_actions = [
	{
	key_id: 'new-' + Date.now(),
	action: '',
	control_hierarchy: '',
	user_id: null, 
	due_date: ''
	}
	];
	}

	if (this.incident && this.incident.reviews && this.incident.reviews.length > 0) {
	const dbRev = this.incident.reviews[0];

	this.reviews.pm.comment = dbRev.pm_comment || '';
	this.reviews.pm.user_id = dbRev.pm_user_id || '';
	this.reviews.pm.accepted = dbRev.pm_accepted !== null && dbRev.pm_accepted !== undefined ? String(dbRev.pm_accepted) : null;

	this.reviews.dept.comment = dbRev.dept_comment || '';
	this.reviews.dept.user_id = dbRev.dept_user_id || '';
	this.reviews.dept.accepted = dbRev.dept_accepted !== null && dbRev.dept_accepted !== undefined ? String(dbRev.dept_accepted) : null;

	this.reviews.ohs.comment = dbRev.ohs_comment || '';
	this.reviews.ohs.user_id = dbRev.ohs_user_id || '';
	this.reviews.ohs.accepted = dbRev.ohs_accepted !== null && dbRev.ohs_accepted !== undefined ? String(dbRev.ohs_accepted) : null;

	this.reviews.dirops.comment = dbRev.dirops_comment || '';
	this.reviews.dirops.user_id = dbRev.dirops_user_id || '';
	this.reviews.dirops.accepted = dbRev.dirops_accepted !== null && dbRev.dirops_accepted !== undefined ? String(dbRev.dirops_accepted) : null;

	this.reviews.ktt.comment = dbRev.ktt_comment || '';
	this.reviews.ktt.user_id = dbRev.ktt_user_id || '';
	this.reviews.ktt.accepted = dbRev.ktt_accepted !== null && dbRev.ktt_accepted !== undefined ? String(dbRev.ktt_accepted) : null;
	}
	console.log('Isi asli KeyLearning:', this.incident.key_learining, '| Tipe:', typeof this.KeyLearning);
	console.log('Apakah ada key_learning (huruf kecil)?:', this.key_learning);
	}, // CLOSED INIT

	// =========================
	// MATRIX LOGIC
	// =========================
	findMatrix() {
	if (!this.consequence_id || !this.likelihood_id) {
	this.resetMatrix()
	return
	}

	const matrix = this.matrices.find((item) =>
	String(item.risk_consequence_id) === String(this.consequence_id) &&
	String(item.risk_likelihood_id) === String(this.likelihood_id)
	)

	this.risk_matrix_id = matrix?.id || ''
	this.assessment_id = matrix?.risk_assessment_id || ''
	},

	resetMatrix() {
	this.risk_matrix_id = ''
	this.assessment_id = ''
	},

	getDataMatrix(id, consequenceId, likelihoodId, assessmentId) {
	this.risk_matrix_id = id
	this.consequence_id = consequenceId
	this.likelihood_id = likelihoodId
	this.assessment_id = assessmentId

	this.$dispatch('field-updated', { field: 'consequence_id' })
	this.$dispatch('field-updated', { field: 'likelihood_id' })
	},

	// =========================
	// UI HELPERS
	// =========================
	getConsequenceDesc() {
	const consequence = this.consequences.find((item) =>
	String(item.ID) === String(this.consequence_id)
	)
	return consequence ? consequence.description : ''
	},
	getConsequenceLevel() {
	const consequence = this.consequences.find((item) =>
	String(item.ID) === String(this.consequence_id)
	);
	// Jika tidak ditemukan, anggap level 0
	return consequence ? parseInt(consequence.severity_level) : 0;
	},


	getLikelihoodNotes() {
	const likelihood = this.likelihoods.find((item) =>
	String(item.ID) === String(this.likelihood_id)
	)
	return likelihood ? likelihood.notes : ''
	},

	getAssessment() {
	return this.assessments.find((item) =>
	String(item.ID) === String(this.assessment_id)
	) || {}
	},

	calculateStatus() {
	// 1. Cek kelengkapan Tab 1 & Tab 2 (Laporan Awal)
	const isTab1Filled = Boolean(
	this.event_category_id && 
	this.location_id && 
	this.IncidentDescription && 
	this.IncidentDescription.trim() !== ''
	);

	const isTab2Filled = this.involved_parties.length > 0 && 
	this.involved_parties.every(p => p.user_id !== null && p.jabatan && p.jabatan.trim() !== '');

	// Jika Tab 1 dan 2 belum lengkap, default status tetap 'submit'
	if (!isTab1Filled || !isTab2Filled) {
	return 'submit';
	}

	// 2. Cek kelengkapan Tab 3 sampai Tab 8 (Tahap Investigasi & Perbaikan)
	const isTab3Filled = this.investigators.length > 0 && 
	this.investigators.every(i => i.employee_id !== null && i.jabatan && i.jabatan.trim() !== '');

	const isTab4Filled = this.peepo_factors.length > 0 && 
	this.peepo_factors.some(f => f.findings && f.findings.trim() !== '');

	const isTab5Filled = this.timelines.length > 0 && 
	this.timelines[0].event && this.timelines[0].event.trim() !== '' && 
	this.validateWhys(this.timelines[0].whys);

	// Cek Tab 6: Apakah minimal ada 1 penyebab (Immediate/Basic cause) yang dipilih
	const allCauses = [
	...this.causes.unsafe_condition,
	...this.causes.unsafe_act,
	...this.causes.personal_factor,
	...this.causes.job_factor,
	...this.causes.control_system
	];
	const isTab6Filled = allCauses.some(c => c.scat_option_id !== '' && c.scat_option_id !== null);

	const isTab7Filled = this.corrective_actions.length > 0 && 
	this.corrective_actions.every(c => c.action && c.action.trim() !== '' && c.user_id !== null && c.due_date && c.due_date.trim() !== '');

	const isTab8Filled = Boolean(this.KeyLearning && this.KeyLearning.trim() !== '');

	// Evaluasi keseluruhan tahap investigasi (Tab 3-8)
	const isInvestigationComplete = isTab3Filled && isTab4Filled && isTab5Filled && isTab6Filled && isTab7Filled && isTab8Filled;
	const isInvestigationStarted = isTab3Filled || isTab4Filled || isTab5Filled || isTab6Filled || isTab7Filled || isTab8Filled;

	// 3. Cek kelengkapan Tab 9 (Review & Persetujuan)
	let isTab9Complete = true;
	for (let config of this.reviewerConfigs) {
	// Hanya cek reviewer yang aktif/visible
	if (this.isReviewVisible(config.key)) {
	// Jika belum lengkap, langsung gagalkan dan hentikan loop
	if (!this.isReviewComplete(config.key)) {
	isTab9Complete = false;
	break;
	}
	}
	}

	// ==========================================
	// PENENTUAN STATUS AKHIR (HIERARKIS)
	// ==========================================
	// Kondisi 1: Tab 1 - 9 selesai semua & disetujui
	if (isInvestigationComplete && isTab9Complete) {
	return 'closed';
	}

	// Kondisi 2: Tab 3 - 8 sudah lengkap, tapi Tab 9 (Review) belum selesai
	if (isInvestigationComplete && !isTab9Complete) {
	return 'pending';
	}

	// Kondisi 3: Tab 3 - 8 baru diisi sebagian / sedang berjalan
	if (isInvestigationStarted) {
	return 'in progress';
	}

	// Kondisi 4: Baru Tab 1 - 2 yang terisi
	return 'submit';
	},



	// =========================
	// WORK TYPE LOGIC
	// =========================
	handleWorkTypeChange(value) {
	if (value === 'department') {
	this.contractor_id = ''
	this.syncData('contractor_id', '')
	return
	}
	this.department_id = ''
	this.syncData('department_id', '')
	},

	// ==========================================
	// HELPER: RAKIT PAYLOAD JSON
	// ==========================================
	buildPayload() {
	let formattedDate = this.event_date;

	// 2. Cek jika formatnya masih mengandung spasi (berasal dari input Flatpickr)
	if (formattedDate && formattedDate.includes(' ')) {

	formattedDate = formattedDate.replace(' ', 'T') + ':00+08:00';
	}
	const parseBool = (val) => {
	if (val === 'true' || val === true || val === '1') return true;
	if (val === 'false' || val === false || val === '0') return false;
	return null;
	};
	return {
	Incident: {
	id: parseInt(this.incident.ID || this.incident.id) || 0,
	event_category_id: parseInt(this.event_type_id) || null,
	scat_option_id: parseInt(this.scat_option_id) || null,
	location_id: parseInt(this.location_id) || null,
	location_specific: this.location_specific,
	tanggal_waktu: formattedDate,
	deskripsi: this.IncidentDescription,
	tugas_dijalankan: this.TaskPerformed,
	tindakan_langsung: this.ImmediateAction,
	key_learning: this.KeyLearning,
	detil_kerusakan_kerugian: this.DamageDetail,
	status: this.calculateStatus(),
	department_id: this.work_type === 'department' ? (parseInt(this.department_id) || null) : null,
	contractor_id: this.work_type === 'contractor' ? (parseInt(this.contractor_id) || null) : null,
	pic_id: parseInt(this.pic_id) || null,
	risk_matrix_id: parseInt(this.risk_matrix_id) || null
	},

	Reviews: {
	pm_comment: this.reviews.pm.comment,
	pm_user_id: this.reviews.pm.user_id ? parseInt(this.reviews.pm.user_id) : null,
	pm_accepted: parseBool(this.reviews.pm.accepted),

	dept_comment: this.reviews.dept.comment,
	dept_user_id: this.reviews.dept.user_id ? parseInt(this.reviews.dept.user_id) : null,
	dept_accepted: parseBool(this.reviews.dept.accepted),

	ohs_comment: this.reviews.ohs.comment,
	ohs_user_id: this.reviews.ohs.user_id ? parseInt(this.reviews.ohs.user_id) : null,
	ohs_accepted: parseBool(this.reviews.ohs.accepted),

	dirops_comment: this.reviews.dirops.comment,
	dirops_user_id: this.reviews.dirops.user_id ? parseInt(this.reviews.dirops.user_id) : null,
	dirops_accepted: parseBool(this.reviews.dirops.accepted),

	ktt_comment: this.reviews.ktt.comment,
	ktt_user_id: this.reviews.ktt.user_id ? parseInt(this.reviews.ktt.user_id) : null,
	ktt_accepted: parseBool(this.reviews.ktt.accepted),
	},

	InvolvedParties: this.involved_parties.map(party => ({
	user_id: party.user_id ? parseInt(party.user_id) : null,
	reporter_manual: party.reporter_manual || '',
	department_id: party.work_type === 'department' ? (parseInt(party.department_id) || null) : null,
	contractor_id: party.work_type === 'contractor' ? (parseInt(party.contractor_id) || null) : null,
	jabatan: party.jabatan,
	roster: party.roster,
	shift: party.shift,
	keterlibatan: party.keterlibatan,
	pengalaman: parseInt(party.pengalaman) || 0
	})),
	InvestigationParticipants: this.investigators.map(inv => ({
	role: inv.role,
	employee_id: inv.employee_id ? parseInt(inv.employee_id) : null,
	jabatan: inv.jabatan,
	work_type: inv.work_type, 
	department_id: inv.work_type === 'department' && inv.department_id ? parseInt(inv.department_id) : null,
	contractor_id: inv.work_type === 'contractor' && inv.contractor_id ? parseInt(inv.contractor_id) : null
	})),
	PeepoFactors: this.peepo_factors.map(p => ({
	factor: p.factor,
	findings: p.findings,
	description: p.description
	})),
	Timelines: this.timelines.map(t => ({
	event: t.event,
	whys: t.whys // Kirim langsung array whys yang sudah terstruktur
	})),
	IncidentCauses: [
	...this.causes.unsafe_condition,
	...this.causes.unsafe_act,
	...this.causes.personal_factor,
	...this.causes.job_factor,
	...this.causes.control_system
	].map(c => ({
	category_type: c.category_type,
	scat_option_id: c.scat_option_id ? parseInt(c.scat_option_id) : null,
	description: c.description
	})),
	CorrectiveActionIncidents: this.corrective_actions.map(item => ({
	action: item.action,
	control_hierarchy: item.control_hierarchy,
	user_id: item.user_id ? parseInt(item.user_id) : null,

	// Logika Pintar:
	// 1. Cek apakah ada nilai
	// 2. Jika sudah mengandung 'T' (berarti sudah format ISO lengkap), gunakan apa adanya.
	// 3. Jika hanya tanggal (format YYYY-MM-DD), baru tambahkan T00:00:00Z
	due_date: (item.due_date && item.due_date !== '') 
	? (item.due_date.includes('T') ? item.due_date : item.due_date + 'T00:00:00Z')
	: null
	}))
	};
	},

	validateWhys(whys) {
	// Jika whys kosong atau bukan array
	if (!whys || !Array.isArray(whys) || whys.length === 0) return false;

	for (let node of whys) {
	// Cek apakah text kosong atau hanya spasi
	if (!node.text || node.text.trim() === '') return false;

	// Jika punya children, cek anak-anaknya secara rekursif
	if (node.children && node.children.length > 0) {
	if (!this.validateWhys(node.children)) return false;
	}
	}
	return true;
	},


	validateReviews() {
	for (let config of this.reviewerConfigs) {
	// 1. Cek apakah blok disembunyikan
	const isVisible = this.isReviewVisible(config.key);

	// 2. CEK APAKAH BLOK INI WAJIB DIISI SAAT INI (Panggilan ke fungsi pintar kita)
	const isRequired = this.isReviewRequired(config.key);

	// Jika blok tidak terlihat ATAU tidak wajib diisi (misal ini blok Dept tapi baru giliran PM)
	// Maka LEWATI validasi untuk blok ini!
	if (!isVisible || !isRequired) continue;

	let r = this.reviews[config.key];

	// 1. Validasi Komentar
	if (!r.comment || r.comment.trim() === '') {
	if (window.showToast) window.showToast(`Komentar untuk ${config.title} wajib diisi!`, 'error');
	return false;
	}

	// 2. Validasi Status Penerimaan
	if (r.accepted === null || r.accepted === '') {
	r.accepted = null;
	if (window.showToast) window.showToast(`Status penerimaan untuk ${config.title} wajib dipilih!`, 'error');
	return false;
	}

	// 3. Validasi User ID
	if (!r.user_id || parseInt(r.user_id) <= 0) {
	r.user_id = null;
	if (window.showToast) window.showToast(`Penanggung jawab untuk ${config.title} belum ditentukan!`, 'error');
	return false;
	}
	}
	return true;
	},

	// ==========================================
	// VALIDASI PER-TAB SEBELUM NEXT
	// ==========================================
	validateStep(step) {
	const container = this.$refs['tab' + step];
	if (!container) return true;

	// 1. Cek HTML5 Validation (HANYA CEK, JANGAN UBAH TAB/SCROLL DISINI)
	const invalidFields = container.querySelectorAll(':invalid');

	if (invalidFields.length > 0) {
	invalidFields.forEach(el => console.log('Elemen bermasalah:', el.name || el.id, el));
	if (window.showToast) window.showToast('Mohon lengkapi field wajib di Tab ' + step, 'error');
	return false; // Langsung kembalikan false
	}

	// 2. Validasi Custom (Bagian 2 - Pihak Terlibat)
	if (step === 2) {
	if (!this.involved_parties || this.involved_parties.length === 0) {
	this.involved_error = true;
	if (window.showToast) window.showToast('BAGIAN 2 wajib diisi minimal 1 personil!', 'error');
	return false;
	}
	for (let i = 0; i < this.involved_parties.length; i++) {
	let party = this.involved_parties[i];
	let hasName = party.user_id || party.reporter_manual.trim() !== '';

	if (!party.user_id) {
	party.user_id = null;
	if (window.showToast) window.showToast(`Karyawan Terlibat pada baris ke-${i + 1} wajib diisi!`, 'error');
	return false;
	}				
	if (!party.jabatan.trim()) {
	if (window.showToast) window.showToast('Lengkapi Jabatan pada baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	if (!party.keterlibatan) {
	if (window.showToast) window.showToast('Lengkapi Keterlibatan pada baris ke-' + (i + 1) + '!', 'error');
	return false;
	}

	if (party.work_type === 'department' && !party.department_id) {
	if (window.showToast) window.showToast('Pilih Department untuk personil baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	if (party.work_type === 'contractor' && !party.contractor_id) {
	if (window.showToast) window.showToast('Pilih Kontraktor untuk personil baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	}
	}

	// 3. Validasi Custom (Bagian 3 - Tim Investigasi)
	if (step === 3) {
	if (!this.investigators || this.investigators.length === 0) {
	this.investigator_error = true;
	if (window.showToast) window.showToast('BAGIAN 3 wajib diisi minimal 1 investigator!', 'error');
	return false;
	}
	for (let i = 0; i < this.investigators.length; i++) {
	let inv = this.investigators[i];

	if (!inv.employee_id || inv.employee_id.toString().trim() === '') {
	inv.employee_id = null;
	if (window.showToast) window.showToast('Mohon pilih Nama/ID pada investigator baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	if (!inv.jabatan || inv.jabatan.trim() === '') {
	if (window.showToast) window.showToast('Mohon lengkapi Jabatan pada investigator baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	if (inv.work_type === 'department' && !inv.department_id) {
	if (window.showToast) window.showToast('Pilih Department untuk investigator baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	if (inv.work_type === 'contractor' && !inv.contractor_id) {
	if (window.showToast) window.showToast('Pilih Kontraktor untuk investigator baris ke-' + (i + 1) + '!', 'error');
	return false;
	}
	}
	}
	// --- BARU: Validasi Custom Bagian 5 ---
	if (step === 5) {
	if (!this.timelines || this.timelines.length === 0) {
	if (window.showToast) window.showToast('Bagian 5 wajib diisi minimal 1 baris analisis!', 'error');
	return false;
	}
	// Pastikan baris pertama ada input event-nya
	if (!this.timelines[0].event || this.timelines[0].event.trim() === '') {
	if (window.showToast) window.showToast('Kejadian/Kronologi pada baris pertama tidak boleh kosong!', 'error');
	return false;
	}
	for (let t of this.timelines) {
	if (!this.validateWhys(t.whys)) {
	if (window.showToast) window.showToast('Setiap baris analisis harus memiliki isi Why yang lengkap!', 'error');
	return false;
	}
	}
	}
	if (Number(step) === 7) {
	// 1. Validasi minimal harus ada 1 baris tindakan perbaikan
	if (!this.corrective_actions || this.corrective_actions.length === 0) {
	if (window.showToast) window.showToast('Bagian 7 wajib diisi minimal 1 tindakan perbaikan!', 'error');
	return false;
	}

	// 2. Loop setiap baris untuk memastikan data di dalamnya tidak kosong
	for (let i = 0; i < this.corrective_actions.length; i++) {
	let item = this.corrective_actions[i];

	// Validasi deskripsi tindakan
	if (!item.action || item.action.trim() === '') {
	if (window.showToast) window.showToast(`Rencana tindakan pada baris ke-${i + 1} tidak boleh kosong!`, 'error');
	return false;
	}

	// Validasi hirarki pengendalian
	if (!item.control_hierarchy || item.control_hierarchy.trim() === '') {
	if (window.showToast) window.showToast(`Hirarki pengendalian pada baris ke-${i + 1} tidak boleh kosong!`, 'error');
	return false;
	}

	// Validasi PIC / Penanggung Jawab
	if (!item.user_id) {
	item.user_id = null;
	if (window.showToast) window.showToast(`Penanggung jawab (PIC) pada baris ke-${i + 1} wajib diisi!`, 'error');
	return false;
	}

	// Validasi Due Date (Nullable / Opsional)
	// Jika diisi, pastikan formatnya benar. Jika tidak, set ke null dan lanjut.
	if (item.due_date && String(item.due_date).trim() !== '') {
	const dueDateVal = String(item.due_date).trim().toLowerCase();
	if (dueDateVal === 'null' || dueDateVal === '0000-00-00') {
	item.due_date = null;
	}
	} else {
	// Jika kosong, pastikan menjadi null agar aman saat dikirim ke database
	item.due_date = null;
	}
	}
	}
	if (step === 9) {
	if (!this.validateReviews()) {
	return false;
	}
	}

	return true;
	},


	focusInvalidField(tabId) {
	// Kita gunakan setTimeout agar menunggu DOM benar-benar siap 
	setTimeout(() => {
	const container = this.$refs['tab' + tabId];
	if (!container) return;


	// 1. Cari semua input/textarea/select yang 'required'
	const allInputs = container.querySelectorAll('input[required]:not([type=\'hidden\']), select[required], textarea[required]');
	let invalidElement = null;

	// 2. Cari secara manual mana yang kosong
	for (let input of allInputs) {
	// Cek apakah nilai kosong atau hanya berisi spasi
	if (!input.value || input.value.trim() === '') {
	invalidElement = input; // HANYA TUGASKAN VARIABELNYA DI SINI
	break; // Berhenti di elemen pertama yang kosong
	}
	}

	// 3. Eksekusi aksi jika ditemukan field yang invalid
	if (invalidElement) {
	// 3. Trigger @invalid.prevent agar Alpine menjalankan isInvalid = true
	invalidElement.dispatchEvent(new Event('invalid', { bubbles: true }));

	// 4. Cek apakah elemen ini disembunyikan (seperti textarea CKEditor)
	if (invalidElement.classList.contains('hidden')) {
	// Ambil parent element (div) tempat kita menyimpan instance editor
	const editorContainer = invalidElement.parentElement;

	// Scroll ke container editor
	editorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });

	// Fokus ke dalam area ketik CKEditor menggunakan API CKEditor 5
	if (editorContainer._editor) {
	editorContainer._editor.editing.view.focus();
	}
	} else {
	// Fallback untuk input standar (teks biasa, select, dll) yang tidak di-hidden
	invalidElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
	invalidElement.focus();
	}

	} else {
	// Fallback: Jika tidak ditemukan input kosong 
	container.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}
	}, 200); 
	},

	// ==========================================
	// SAVE DATA KE BACKEND TANPA REDIRECT
	// ==========================================
	async saveBackground() {

	const payload = this.buildPayload();
	const formData = new FormData();
	formData.append('payload', JSON.stringify(payload));

	const deletedInputs = document.getElementsByName('deleted_files[]');
	for (let i = 0; i < deletedInputs.length; i++) {
	formData.append('deleted_files[]', deletedInputs[i].value);
	}

	const fileInput = document.getElementById('dokumentasi_desc');
	if (fileInput && fileInput.files && fileInput.files.length > 0) {
	for (let i = 0; i < fileInput.files.length; i++) {
	formData.append('dokumentasi[]', fileInput.files[i]);
	}
	}

	try {
	const incidentID = this.incident.ID || this.incident.id;

	const response = await fetch('/incident/update/' + incidentID, {
	method: 'POST',
	headers: { 
	'Accept': 'application/json' 
	},
	body: formData
	});

	if (!response.ok) {
	const errText = await response.text();
	throw new Error(errText || 'Terjadi kesalahan internal server.');
	}
	return true;
	} catch (error) {
	if (window.showToast) window.showToast('Gagal menyimpan progress: ' + error.message, 'error');
	return false;
	}
	},

	// ==========================================
	// LOGIKA TOMBOL NEXT DIKLIK
	// ==========================================
	async goNext() {
	// 1. Jalankan validasi terlebih dahulu
	if (!this.validateStep(this.activeTab)) {
	// Jika GAGAL, pastikan isSubmitting tetap false agar tidak loading
	this.focusInvalidField(this.activeTab);
	return; 
	}


	this.isSubmitting = true;
	this.showErrors = true;

	try {
	// 3. Jalankan proses simpan data di background
	const success = await this.saveBackground();

	if (success) {
	if (window.showToast) {
	window.showToast('Progress Bagian ' + this.activeTab + ' tersimpan.', 'success');
	}
	this.activeTab++;
	}
	} catch (error) {
	console.error('Error pada goNext:', error);
	} finally {
	// 4. PENTING: Apapun yang terjadi (sukses atau error dari server), 
	// matikan kembali status loading agar tombol bisa digunakan lagi.
	this.isSubmitting = false;
	this.showErrors = true;
	}
	},

	// ====================================================
	// FORM FINAL SUBMIT (TOMBOL UPDATE PALING BAWAH)
	// ====================================================
	async handleSubmit(e) {

	// 1. Validasi dulu semua tab
	for (let i = 1; i <= this.totalTabs; i++) {
	// Cek validasi custom Anda
	if (!this.validateStep(i)) {

	// Pindah ke tab yang bermasalah
	this.activeTab = i;

	// Tunggu transisi DOM/Animasi
	this.$nextTick(() => {
	setTimeout(() => {
	const container = this.$refs['tab' + i];
	if (!container) return;

	// --- PERUBAHAN DI SINI ---
	// 1. Cari semua input/textarea/select yang 'required'
	const allInputs = container.querySelectorAll('[required]');
	let invalidElement = null;

	// 2. Cari secara manual mana yang kosong
	for (let input of allInputs) {
	if (!input.value || input.value.trim() === '') {
	invalidElement = input;
	break; // Berhenti di elemen pertama yang kosong
	}
	}

	if (invalidElement) {
	// 3. Trigger @invalid.prevent agar Alpine menjalankan isInvalid = true
	invalidElement.dispatchEvent(new Event('invalid', { bubbles: true }));

	// 4. Cek apakah elemen ini disembunyikan (seperti textarea CKEditor)
	if (invalidElement.classList.contains('hidden')) {
	// Ambil parent element (div) tempat kita menyimpan instance editor
	const editorContainer = invalidElement.parentElement;

	// Scroll ke container editor
	editorContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });

	// Fokus ke dalam area ketik CKEditor menggunakan API CKEditor 5
	if (editorContainer._editor) {
	editorContainer._editor.editing.view.focus();
	}
	} else {
	// Fallback untuk input standar (teks biasa, select, dll) yang tidak di-hidden
	invalidElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
	invalidElement.focus();
	}

	} else {
	// Fallback: Jika tidak ditemukan input kosong 
	container.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}
	}, 500);
	});

	return; // Berhenti di sini
	}
	}

	// 2. Jika semua valid, lanjut submit
	const form = e.target;
	if (form.dataset.submitting === 'true') return;
	form.dataset.submitting = 'true';

	const success = await this.saveBackground();

	if (success) {
	const incidentID = this.incident.ID || this.incident.id;
	this.isSubmitting = true;

	sessionStorage.setItem('flash_msg', 'Berhasil!');
	window.location.href = `/incident/edit/${incidentID}`;
	} else {
	form.dataset.submitting = 'false';
	this.isSubmitting = false;

	}
	},

	// =========================
	// BACKEND SYNC
	// =========================
	async syncData(name, value, isInit = false) {
	this[name] = value
	if (name === 'reporter_id') return

	const formData = new FormData()
	formData.append('name', name)
	formData.append('value', value)

	try {
	const response = await fetch('/incident/sync', {
	method: 'POST',
	body: formData
	})
	const result = await response.json()
	if (result.status !== 'success') return

	if (name === 'event_category_id') {
	this.all_types = result.types || []
	if (!isInit) this.event_type_id = ''
	}

	if (name === 'department_id' || name === 'contractor_id') {
	this.all_pics = result.pics || []
	if (!isInit) this.pic_id = ''
	}
	} catch (error) {

	}
	}
	}" id="incident-form">
	<div class="flex items-center justify-between mb-2 font-semibold">
		<div>
			<h3 class="text-sm font-bold text-base-content uppercase tracking-wider">{{ index .Tr "RingkasanInsiden" }}</h3>
			<p class="text-xs text-slate-500">{{ index .Tr "subJudulIncident" }}</p>
		</div>

		<!-- Badge Status Dinamis -->
		<div class="kbd kbd-lg">
			<div class="badge font-bold uppercase text-xs px-3 py-2 text-white"
				:class="{
				'badge-info': calculateStatus() === 'submit',
				'badge-warning': calculateStatus() === 'in progress',
				'badge-error': calculateStatus() === 'pending',
				'badge-success': calculateStatus() === 'closed'
				}">
				<span x-text="calculateStatus()"></span>
			</div>
		</div>
	</div>

	<form x-ref="form" action="/incident/update/{{ .Incident.ID }}" method="POST" enctype="multipart/form-data" @submit.prevent="handleSubmit" novalidate>
		{{ template "card_scroll" . }}

		<div class="flex justify-between items-center py-2">
			<button 
				type="button" 
				class="btn btn-secondary btn-soft btn-xs"
				:disabled="activeTab === 1"  
				@click="activeTab--">
				{{ lucide "chevrons-left" (dict "class" "size-4") }} {{ index .Tr "Previous" }}
			</button>

			<span class="text-xs text-base-content/50" x-text="`Step ${activeTab} of ${totalTabs}`"></span>

			<button 
				type="button" 
				class="btn btn-secondary btn-soft btn-xs"
				x-show="activeTab < totalTabs" 
				@click="goNext()">

				<span x-show="!isSubmitting" class="flex items-center gap-1">
					{{ index .Tr "SaveNext" }} {{ lucide "chevrons-right" (dict "class" "size-4") }}
				</span>
				<span x-show="isSubmitting" class="flex items-center gap-1">
					<span class="loading loading-spinner loading-xs"></span> 

					{{ index .Tr "Save" }}... {{ lucide "send-horizontal" (dict "class" "size-4") }}
				</span>

			</button>

			<button 
				type="submit" 
				class="btn btn-success btn-xs"
				x-show="activeTab === totalTabs">
				<span x-show="!isSubmitting" class="flex items-center gap-1">
					{{ lucide "save" (dict "class" "size-4") }} {{ index .Tr "Update" }}
				</span>
				<span x-show="isSubmitting" class="flex items-center gap-1">
					<span class="loading loading-spinner loading-xs"></span> 

					{{ index .Tr "Save" }}... {{ lucide "send-horizontal" (dict "class" "size-4") }}
				</span>

			</button>

		</div>

	</form>
</div>
{{ end }}

{{ define "slot" }}

<div  class="w-full mx-auto">

	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab1">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 1" @change="activeTab = 1" />
		<div class="collapse-title font-semibold">
			<h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian1" }}</h3>
			<p class="text-xs text-slate-500">{{ index .Tr "Subbagian1" }}</p>
		</div>
		<div class="collapse-content">
			<div>
				<template x-if="activeTab === 1">
					<div class="bg-base-100 rounded-md border border-base-200 p-2">
						<div class="grid grid-cols-1 md:grid-cols-4 gap-2 ">
							<div class="relative " @change="syncData('event_category_id', $event.detail)">
								{{ template "select-search" (dict
									"Label" (index .Tr "ReportType")
									"Name" "event_category_id"
									"ModelName" "event_category_id"
									"Value" .Incident.EventCategory.ParentID
									"Options" .EventCategories
									"Required" true
									"DefaultText" "-- Pilih Tipe Bahaya --"
									"Placeholder" "Cari tipe bahaya..."
									)
								}}
							</div>
							{{ template "select-dynamic" (dict "Label" (index .Tr "HazardType") "Name" "event_type_id" "Value" .Incident.EventCategoryID "Model" "event_type_id" "OptionsArray" "all_types" "ShowCondition" "event_category_id" "DefaultText" (index .Tr "SelectHazardType") "Required" true) }}
							{{ template "select_input" (dict "Label" (index .Tr "HazardCategory") "Name" "scat_option_id" "ShowType" true "Model" "scat_option_id" "Placeholder" (index .Tr "SelectHazardCategory") "Options" .ScatOptions "Required" true) }}

							<div class="relative my-select-field" @change="location_id = $event.detail">
								{{ template "select-search" (dict
									"Label" (index .Tr "Location")
									"Name" "location_id"
									"Value" .Incident.LocationID
									"Options" .Locations
									"Required" true
									"DefaultText" (index .Tr "SelectLocation")
									"Attr" "x-model='location_id'"
									"SearchURL" "/incident/locations/search"
									"Placeholder" "Cari nama lokasi..."
									)
								}}
							</div>

							{{ template "input" (dict "Label" (index .Tr "LocationSpecific") "Name" "location_specific" "Placeholder" (index .Tr "InputLocationSpecific") "ShowCondition" "location_id" "Required" true "Attr" "x-model='location_specific'") }}

							<div class="relative ">
								{{ template "select-user-search" (dict "Label" (index .Tr "ReporterName") "Options" .Users "Value" .AuthUser.ID "SelectedLabel" .AuthUser.Name "DefaultValue" .AuthUser.ID "DefaultText" (index .Tr "SelectReporterName") "Attr" "x-model='reporter_id'" "Required" true) }}
							</div>

							{{ template "input-flatpickr" dict
								"Label" (index .Tr "DateTimeObservation")
								"Name" "event_date"
								"Id" "event_date"
								"Value" (.Incident.TanggalWaktu.Format "2006-01-02 15:04")
								"Type" "date-time"
								"Placeholder" (index .Tr "InputDateObservation")
								"Required" true
								"RequiredBinding" ""
								"Attr" "x-model=event_date"
							}}
						</div>

						<fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border px-2 mt-4">
							<legend class="fieldset-legend">{{ index .Tr "ResponsibleParty" }}</legend>
							<div class="flex flex-col md:flex-row items-center gap-2 ">
								<fieldset class="w-full">
									<input id="draft" class="peer/draft" type="radio" value="department" name="work_type" x-model="work_type" checked />
									<label for="draft" class="peer-checked/draft:text-info text-sm font-semibold text-base-content opacity-60 mb-1 ">{{ index .Tr "Department" }}</label>

									<input id="published" class="peer/published" type="radio" name="work_type" value="contractor" x-model="work_type" />
									<label for="published" class="peer-checked/published:text-info text-sm font-semibold mb-1 text-base-content opacity-60">{{ index .Tr "Contractor" }}</label>

									<div class="hidden peer-checked/draft:block relative" @change="syncData('department_id', $event.detail)">
										{{ template "select-search" (dict "Label" ""
											"Name" "department_id"
											"Value" .Incident.DepartmentID
											"ModelName" "department_id"
											"Options" .Departments
											"SearchURL" "/incident/departments/search"
											"DefaultText" (index .Tr "SelectDepartment")
											"Attr" "x-model='department_id' aria-label='Pilih Department'"
											"RequiredBinding" "work_type === 'department'"
											)
										}}
									</div>

									<div class="hidden peer-checked/published:block relative" @change="syncData('contractor_id', $event.detail)">
										{{ template "select-search" (dict
											"Label" ""
											"Name" "contractor_id"
											"ModelName" "contractor_id"
											"Value" .Incident.ContractorID
											"Options" .Contractors
											"SearchURL" "/incident/contractors/search"
											"DefaultText" (index .Tr "SelectContractor")
											"Attr" "x-model='contractor_id' aria-label='Pilih Kontraktor'"
											"RequiredBinding" "work_type === 'contractor'"
											)
										}}
									</div>
								</fieldset>
								{{ template "select-dynamic" (dict
									"Label" (index .Tr "PIC")
									"Name" "pic_id"
									"Model" "pic_id"
									"OptionsArray" "all_pics"
									"ShowCondition" "work_type"
									"DefaultText" (index .Tr "SelectPIC")
									"Required" true
									)
								}}
							</div>
						</fieldset>

						{{ template "ckeditor" dict "ID" "TaskPerformed" "Label" (index .Tr "TaskPerformed") "Name" "tugas_dijalankan" "Model" "TaskPerformed" "Value" .Incident.TugasDijalankan "Required" true "Attr" "" }}
						{{ template "ckeditor" dict "ID" "IncidentDescription" "Label" (index .Tr "IncidentDescription") "Placeholder" (index .Tr "IncidentDescriptionPlaceholder") "Name" "deskripsi" "Model" "IncidentDescription" "Value" .Incident.Deskripsi "Required" true }}

						{{ template "input-file" (dict
							"Id" "dokumentasi_desc"
							"Name" "dokumentasi_desc"
							"Label" (index .Tr "UploadDocument")
							"Required" true
							"Accept" "image/*, application/pdf"
							"DragDropUpload" (index .Tr "DragDropUpload")
							"SubDragDropUpload" (index .Tr "SubDragDropUpload")
							"ExistingFiles" .Docs
							"DisabledBinding" "false"
							"Attr" ""
							)
						}}
						{{ template "ckeditor" dict "ID" "ImmediateAction" "Label" (index .Tr "ImmediateAction") "Placeholder" (index .Tr "WorkStatus") "Name" "tindakan_langsung" "Model" "ImmediateAction" "Value" .Incident.TindakanLangsung "Required" true }}
						{{ template "ckeditor" dict "ID" "DamageDetail" "Label" (index .Tr "DamageDetail") "Placeholder" (index .Tr "UnplannedOutcome") "Name" "detil_kerusakan_kerugian" "Model" "DamageDetail" "Value" .Incident.DetilKerusakanKerugian "Required" true }}

						<div class="flex flex-col md:flex-row gap-2 mt-4">
							<div class="col-span-2 md:grow">
								<div class="flex-col">
									{{ template "select_input" (dict "Label" "Consequences" "Name" "consequence_id" "Model" "consequence_id" "Placeholder" "Pilih Consequences" "Class" "max-w-sm" "Options" .Consequences "Required" true) }}
									<div x-show="consequence_id" x-transition>
										<textarea class="textarea textarea-bordered w-full" x-text="getConsequenceDesc()" readonly></textarea>

									</div>

									{{ template "select_input" (dict "Label" "Likelihood" "Name" "likelihood_id" "Model" "likelihood_id" "Placeholder" "Pilih Likelihood" "Class" "max-w-sm" "Options" .Likelihoods "Required" true) }}
									<div x-show="likelihood_id" x-transition>
										<textarea class="textarea textarea-bordered w-full" x-text="getLikelihoodNotes()" readonly></textarea>
									</div>
								</div>
							</div>

							<div class="md:flex-none">
								<div class="flex flex-col items-center max-w-md">
									<table class="border-collapse border border-base-300 text-[10px]">
										<caption class="caption-top font-bold text-center bg-base-200 border border-base-300">RISK MATRIX GRID</caption>
										<thead>
											<tr>
												<th rowspan="2" colspan="2" class="border border-base-300 p-2 bg-base-200 italic">Likelihood</th>
												<th colspan="5" class="border border-base-300 p-1 bg-base-200">Consequence</th>
											</tr>
											<tr class="bg-base-200 text-center">
												{{ range $c := $.Consequences }}
													<th class="border border-base-300 p-1 w-24">{{ $c.Name }}</th>
												{{ end }}
											</tr>
										</thead>
										<tbody>
											{{ range $l := .Likelihoods }}
												<tr>
													<td class="border border-base-300 bg-base-200 p-2 font-bold">{{ $l.Sequence }}</td>
													<td class="border border-base-300 bg-base-200 p-2 font-medium w-full max-w-xs">{{ $l.Name }}</td>
													{{ range $c := $.Consequences }}
														{{ $mID := getMatrixID $.Matrices $c.ID $l.ID }}
														{{ $aID := getMatrixAssessmentID $.Matrices $c.ID $l.ID }}
														<td class="border border-base-300 text-center font-bold text-base-content uppercase shadow-inner cursor-pointer hover:opacity-80 hover:scale-[1.02] transition-all"
															:class="risk_matrix_id == '{{ $mID }}' ? 'ring-2 ring-black ring-inset scale-105 z-10 '  : ''"
															style="background-color: {{ getMatrixColor $.Matrices $c.ID $l.ID }};"
															@click="if('{{ $mID }}' !== '0') { getDataMatrix('{{ $mID }}', '{{ $c.ID }}', '{{ $l.ID }}', '{{ $aID }}') }">
															{{ firstChar (getMatrixName $.Matrices $c.ID $l.ID) }}
															<input type="hidden" name="risk_matrix_id" x-model="risk_matrix_id">
														</td>
													{{ end }}
												</tr>
											{{ end }}
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<div x-show="assessment_id" x-transition class="my-3 overflow-x-auto">
							<table class="table table-xs table-zebra w-full border border-base-300 rounded-box">
								<tbody>
									<tr>
										<td class="font-semibold w-40">Assessment</td>
										<td><span class="font-bold" x-text="getAssessment().name || '-'"></span></td>
									</tr>
									<tr>
										<td class="font-semibold">Notes</td>
										<td><div class="whitespace-pre-line text-sm" x-text="getAssessment().notes || '-'"></div></td>
									</tr>
									<tr>
										<td class="font-semibold">Investigation Required</td>
										<td><div class="whitespace-pre-line text-sm" x-text="getAssessment().investigation_reqd || '-'"></div></td>
									</tr>
									<tr>
										<td class="font-semibold">Reporting Obligation</td>
										<td><span x-text="getAssessment().reporting_obligation || '-'"></span></td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</template>	
			</div>
		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab2">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 2" @change="activeTab = 2" />
		<div class="collapse-title font-semibold">
			<h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian2" }}</h3>
			<p class="text-xs text-slate-500">{{ index .Tr "Subbagian2" }}</p>
		</div>
		<div class="collapse-content">

			<div>
				<template x-if="activeTab === 2">
					<div class="overflow-y-scroll w-full bg-white rounded-lg border border-slate-200">
						<table class="table table-compact w-full text-sm">
							<thead class="bg-slate-100 text-slate-700">
								<tr>
									<th class="w-10">No</th>
									<th class="w-64">Nama Personil</th>
									<th class="w-48">Perusahaan / Dept</th>
									<th class="w-32">Jabatan</th>
									<th class="w-24">Roster</th>
									<th class="w-24">Shift</th>
									<th class="w-40">Keterlibatan</th>
									<th class="w-20">Pengalaman (Thn)</th>
									<th class="w-12 text-center">Aksi</th>
								</tr>
							</thead>
							<tbody>
								<template x-for="(party, index) in involved_parties" :key="index">
									<tr class="hover:bg-slate-50 transition-colors focus-within:relative focus-within:z-50">
										<td class="font-bold text-center align-middle" x-text="index + 1"></td>

										<td class="align-middle">
											{{ template "select-user-search_model" (dict
												"Label" ""
												"Options" .Users
												"Model" "party.user_id"
												"DefaultText" "-- Pilih Personil --"
												"Required" true
												)
											}}

										</td>

										<td>
											<div class="flex flex-col gap-1">
												{{ template "select_input" (dict
													"Label" ""
													"Name" "work_type"
													"Model" "party.work_type"
													"Placeholder" "Pilih Tipe"
													"Required" true
													"Slot" "<option value='department'>Internal Dept</option><option value='contractor'>Kontraktor</option>"
													)
												}}

												<template x-if="party.work_type === 'department'">
													<div>
														{{ template "select-search-loop" (dict
															"Name" "department_id[]"
															"Placeholder" (index .Tr "SearchDept")
															"DefaultText" (index .Tr "SelectDepartment")
															"AlpineVar" "party.department_id"
															"Options" $.Departments
															"SearchURL" "/incident/departments/search"
															"RequiredBinding" "party.department_id != null"
															)
														}}

													</div>
												</template>

												<template x-if="party.work_type === 'contractor'">
													<div>
														{{ template "select-search-loop" (dict
															"Name" "contractor_id[]"
															"Placeholder" (index .Tr "SearchContractor")
															"DefaultText" (index .Tr "SelectContractor")
															"AlpineVar" "party.contractor_id"
															"Options" $.Contractors
															"SearchURL" "/incident/contractors/search"
															"RequiredBinding" "party.contractor_id != null"
															)
														}}

													</div>
												</template>
											</div>
										</td>
										<td >
											{{ template "input" (dict
												"Label" ""
												"Name" "jabatan"
												"Placeholder" "Jabatan"
												"Required" true
												"Attr" "x-model='party.jabatan'"
												)
											}}

										</td>
										<td >
											{{ template "input" (dict
												"Label" ""
												"Name" "roster"
												"Placeholder" "Roster"
												"Required" true
												"Attr" "x-model='party.roster'"
												)
											}}
										</td>
										<td>
											{{ template "select_input" (dict
												"Label" ""
												"Name" "Sift"
												"Model" "party.shift"
												"Placeholder" "Pilih Sift"
												"Required" true
												"Slot" "<option value='Day'>Day</option><option value='Night'>Night</option>"
												)
											}}

										</td>
										<td>
											{{ template "select_input" (dict
												"Label" ""
												"Name" "Keterlibatan"
												"Model" "party.keterlibatan"
												"Placeholder" "Pilih"
												"Required" true
												"Slot" "<option value='Saksi'>Saksi</option><option value='Korban Cedera'>Korban Cedera</option><option value='Operator Unit'>Operator Unit</option><option value='Pengawas Lapangan'>Pengawas Lapangan</option>"
												)
											}}

										</td>
										<td>
											{{ template "input" (dict
												"Label" ""
												"Type" "number"
												"Name" "pengalaman"
												"Placeholder" "Pengalaman"
												"Required" true
												"Attr" "x-model='party.pengalaman'"
												)
											}}
										</td>

										<td class="text-center align-middle">
											<template x-if="index >= 0">
												<button type="button" 
													@click="removeInvolvedParty(index)" 
													class="btn btn-xs btn-error text-white flex items-center gap-1 mx-auto"
													title="Hapus baris ini">
													<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
													</svg>
													<span>Hapus</span>
												</button>
											</template>
										</td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
				</template>
			</div>

			<div class="mt-2">
				<button 
					type="button" 
					class="btn btn-accent btn-soft btn-sm"
					@click="addInvolvedParty()">
					{{ lucide "user-round-plus" (dict "class" "size-4") }} {{ index .Tr "TambahPersonil" }}
				</button>
			</div>
			<input type="hidden" name="involved_parties_json" :value="JSON.stringify(involved_parties)">

		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab3">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 3" @change="activeTab = 3" />
		<div class="collapse-title font-semibold"><h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian3" }}</h3></div>
		<div class="collapse-content">
			<div>
				<template x-if="activeTab === 3">
					<div class="overflow-y-scroll w-full bg-white rounded-lg border border-slate-200">
						<table class="table table-xs w-full">
							<thead>
								<tr class="bg-base-200">
									<th>Peran</th>
									<th>Nama Personil</th>
									<th>Jabatan</th>
									<th>Tipe Dept/Perusahaan</th>
									<th>Nama Dept/Perusahaan</th>
									<th>Aksi</th>
								</tr>
							</thead>
							<tbody>
								<template x-for="(inv, index) in investigators" :key="inv.id_existing || index">
									<tr class="hover:bg-slate-50 transition-colors focus-within:relative focus-within:z-50">
										<td>
											<select x-model="inv.role" class="select select-bordered select-xs w-full
												focus:outline-none focus:border-info
												leading-normal focus:ring-info
												appearance-none">
												<option value="Pemimpin Investigasi">Pemimpin Investigasi</option>
												<option value="Facilitator">Facilitator</option>
												<option value="Anggota">Anggota</option>
											</select>
										</td>

										<td>
											{{ template "select-user-search_model" (dict
												"Label" ""
												"Name" "employee_id"
												"Options" .Users
												"Model" "inv.employee_id"
												"DefaultText" "-- Pilih Personil --"
												"Required" true
												)
											}}

										</td>

										<td>


											{{ template "input" (dict
												"Label" ""
												"Name" ""
												"Placeholder" "Jabatan"
												"Required" true
												"Attr" "x-model='inv.jabatan'"
												)
											}}
										</td>

										<td>
											<select x-model="inv.work_type" @change="inv.department_id = ''; inv.contractor_id = ''" class="select select-bordered select-xs w-full
												focus:outline-none focus:border-info
												leading-normal focus:ring-info
												appearance-none">
												<option value="department">Internal (Department)</option>
												<option value="contractor">Eksternal (Contractor)</option>
											</select>
										</td>

										<td>

											<template x-if="inv.work_type === 'department'">

												{{ template "select-search-loop" (dict
													"Name" "department_id[]"
													"Placeholder" (index .Tr "SearchDept")
													"DefaultText" (index .Tr "SelectDepartment")
													"AlpineVar" "inv.department_id"
													"Options" $.Departments
													"SearchURL" "/incident/departments/search"
													"RequiredBinding" "inv.department_id != null"
													"Attr" "@change=\"syncData('department_id', inv.department_id, index)\""
													)
												}}
											</template>

											<template x-if="inv.work_type === 'contractor'">
												{{ template "select-search-loop" (dict
													"Name" "contractor_id[]"
													"Placeholder" (index .Tr "SearchDept")
													"DefaultText" (index .Tr "SelectContractor")
													"AlpineVar" "inv.contractor_id"
													"Options" $.Contractors
													"SearchURL" "/incident/contractors/search"
													"RequiredBinding" "inv.contractor_id != null"
													"Attr" "@change=\"syncData('contractor_id', inv.contractor_id, index)\""
													)
												}}


											</template>

										</td>

										<td>
											<button type="button" @click="removeInvestigator(index)" class="btn btn-error btn-xs btn-square text-white">
												✕
											</button>
										</td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
				</template>
			</div>

			<div class="mt-4 flex gap-2">

				<button 
					type="button" 
					class="btn btn-accent btn-soft btn-xs"
					@click="addInvestigator('Pemimpin Investigasi')">
					{{ lucide "circle-plus" (dict "class" "size-4") }} {{ index .Tr "TambahPemimpin" }}
				</button>
				<button 
					type="button" 
					class="btn btn-info btn-soft btn-xs"
					@click="addInvestigator('Facilitator')">
					{{ lucide "circle-plus" (dict "class" "size-4") }} {{ index .Tr "TambahFacilitator" }}
				</button>
				<button 
					type="button" 
					class="btn btn-primary btn-soft btn-xs"
					@click="addInvestigator('Anggota')">
					{{ lucide "circle-plus" (dict "class" "size-4") }} {{ index .Tr "TambahAnggota" }}
				</button>
			</div>
		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab4">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 4" @change="activeTab = 4" />
		<div class="collapse-title font-semibold"><h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian4" }}</h3></div>
		<div class="collapse-content text-sm">
			<div>
				<template x-if="activeTab === 4">
					<div class="overflow-y-scroll w-full bg-white rounded-lg border border-slate-200">
						<table class="table table-xs w-full">
							<thead>
								<tr class="bg-base-200">
									<th>Faktor</th>
									<th>Temuan</th>
									<th>Deskripsi</th>
									<th class="w-16">Aksi</th>
								</tr>
							</thead>
							<tbody>
								<template x-for="(item, index) in peepo_factors" :key="index">
									<tr class="hover:bg-slate-50 transition-colors focus-within:relative focus-within:z-50">
										<td>
											<select x-model="item.factor" class="select select-bordered select-xs w-full
												focus:outline-none focus:border-info
												leading-normal focus:ring-info
												appearance-none">
												<option value="Orang">Orang</option>
												<option value="Peralatan">Peralatan</option>
												<option value="Lingkungan">Lingkungan</option>
												<option value="Prosedur">Prosedur</option>
												<option value="Organisasi">Organisasi</option>
											</select>
										</td>
										<td>
											{{ template "textarea" (dict
												"Label" ""
												"Name" "finding"
												"Placeholder" "Sebutkan poin utama temuan atau masalah yang ditemukan..."
												"Required" true
												"Attr" " x-model='item.findings'"
												)
											}}
										</td>
										<td>
											{{ template "textarea" (dict
												"Label" ""
												"Name" "description"
												"Placeholder" "Berikan penjelasan detail, konteks, atau kronologi kejadian..."
												"Required" true
												"Attr" " x-model='item.description'"
												)
											}}
										</td>
										<td>
											<button type="button" @click="removeFactor(index)" class="btn btn-error btn-xs btn-square text-white">x</button>
										</td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
				</template>
			</div>
			<button type="button" @click="addFactor()" class="mt-2 btn btn-outline btn-xs">
				+ Tambah Faktor
			</button>

		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab5">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 5" @change="activeTab = 5" />
		<div class="collapse-title font-semibold">
			<h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian5" }}</h3>
		</div>

		<div class="collapse-content text-sm">
			<div>
				<template x-if="activeTab === 5">
					<div class="space-y-6">
						<template x-for="(item, tIndex) in timelines" :key="tIndex">
							<div class="p-4 bg-slate-50 border border-slate-200 rounded-lg shadow-sm ">

								<div class="mb-4 ">
									<div role="alert" class="alert alert-vertical sm:alert-horizontal border-l-4 border-info">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current text-info h-6 w-6 shrink-0">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
										</svg>
										<div class="">
											<h3 class="font-bold">Kejadian / Kronologi</h3>
											<div class="text-xs prose" x-html="item.event"></div>	
										</div>

									</div>
								</div>

								<div class="space-y-3 ">
									<template x-for="(why, wIndex) in item.whys" :key="wIndex">
										<div class="card bg-base-100 border border-base-200 shadow-sm mb-4">
											<div class="card-body p-4 gap-4">

												<div class="flex gap-4 items-start">
													<div class="flex-none pt-2">
														<span class="badge badge-primary font-bold text-white px-3 py-3">
															{{ index .Tr "Why" }} <span x-text="wIndex + 1"></span>
														</span>
													</div>

													<div class="flex-grow">
														{{ template "textarea" (dict
															"Label" ""
															"Name" "why"
															"Placeholder" "Mengapa hal ini terjadi?..."
															"Required" true
															"Attr" " x-model='why.text' class='w-full'"
															)
														}}
													</div>

													<div class="flex flex-col gap-1">
														<button type="button" @click="addChildWhy(tIndex, wIndex)" class="btn btn-xs btn-outline btn-info tooltip" data-tip="Tambah Sub-Why">
															{{ lucide "plus" (dict "class" "size-4") }}
														</button>
														<button type="button" @click="removeWhy(tIndex, wIndex)" class="btn btn-xs btn-outline btn-error tooltip" data-tip="Hapus Why">
															{{ lucide "trash-2" (dict "class" "size-4") }}
														</button>
													</div>
												</div>

												<template x-if="why.children && why.children.length > 0">
													<div class="pl-16 space-y-3">
														<div class="divider text-xs text-slate-400 opacity-50 uppercase tracking-widest">Detail Pendukung</div>

														<template x-for="(child, cIndex) in why.children" :key="cIndex">
															<div class="flex gap-3 items-start p-3 bg-base-200/50 rounded-lg border border-base-200">
																<span class="mt-2 text-xs font-mono text-slate-500">└─</span>
																<div class="flex-grow">
																	{{ template "textarea" (dict
																		"Label" ""
																		"Name" "child_why"
																		"Placeholder" "Tambahkan detail/sub-alasan..."
																		"Required" true
																		"Attr" " x-model='child.text' class='w-full text-sm'"
																		)
																	}}
																</div>
																<button type="button" @click="removeChildWhy(tIndex, wIndex, cIndex)" class="btn btn-ghost btn-xs text-error">
																	{{ lucide "circle-x" (dict "class" "size-4") }}
																</button>
															</div>
														</template>
													</div>
												</template>
											</div>
										</div>
									</template>
								</div>

								<button type="button" @click="addWhy(tIndex)" class="mt-4 btn btn-primary btn-xs">
									+ Tambah Why Utama
								</button>
							</div>
						</template>
					</div>
				</template>
			</div>
		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab6">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 6" @change="activeTab = 6" />
		<div class="collapse-title font-semibold">
			<h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian6" }}</h3>
		</div>
		<div class="collapse-content text-sm">
			<div>
				<template x-if="activeTab === 6">
					<div class="space-y-8"> 
						<div class="p-4 border border-error/40 rounded-md">
							<h3 class="text-base font-bold mb-2 border-b border-base-300 pb-2 text-error">Penyebab Langsung</h3>
							<div class="space-y-4">
								<template x-for="(label, key) in {
									'unsafe_condition': 'Unsafe Condition',
									'unsafe_act': 'Unsafe Act'
									}" :key="key">
									<div class="card card-xs bg-base-200 shadow-sm p-2">
										<div class="card-body">
											<h4 class="card-title font-bold text-slate-600 mb-3" x-text="label"></h4>
											<template x-for="(item, index) in causes[key]" :key="index">
												<div class="flex gap-4 hover:bg-base-300 items-center mb-2">
													<div class="flex-1 ">
														<div class="flex flex-col">
															{{ template "select_input" (dict
																"Model" "item.scat_option_id"
																"Placeholder" "Pilih"
																"Required" true
																"Class" "w-96"
																"Slot" "<template x-for='opt in getScatOptions(key)' :key='opt.ID'><option :value='opt.ID' :selected='opt.ID == item.scat_option_id' x-text='opt.Code + \" - \" + opt.Name'></option></template>"
																)
															}}
															{{ template "textarea" (dict
																"Label" ""
																"Name" "description_cause"
																"Placeholder" "Sub-alasan..."
																"Required" true
																"Attr" " x-model='item.description'"
																)
															}}
														</div>
													</div>
													<div class="w-14 flex-none">
														<div class="w-14 flex-none">
															<div class="tooltip" :data-tip="'Hapus ' + label">
																<button type="button" @click="causes[key].splice(index, 1)"  class="btn btn-xs btn-square btn-soft btn-error ">
																	{{ lucide "circle-x" (dict "class" "size-4") }} 
																</button>
															</div>
														</div>
													</div>
												</div>
											</template>
											<div class="justify-end card-actions">
												<button 
													type="button" 
													class="btn btn-accent  btn-dash btn-xs mt-2"
													@click="causes[key].push({category_type: key, scat_option_id: '', description: ''})" >
													{{ lucide "plus" (dict "class" "size-4") }} {{ index .Tr "TambahBaris" }} <span x-text="label"></span>
												</button>
											</div>
										</div>
									</div>
								</template>
							</div>
						</div>
						<div class="p-4 border border-warning rounded-md">
							<h3 class="text-base font-bold mb-2 border-b border-base-300 pb-2 text-warning">Penyebab Dasar</h3>
							<div class="space-y-4">
								<template x-for="(label, key) in {
									'personal_factor': 'Personal Factor',
									'job_factor': 'Job Factor',
									'control_system': 'Control Weakness'
									}" :key="key">
									<div class="card card-xs bg-base-200 shadow-sm p-2">
										<div class="card-body">
											<h4 class="card-title  font-bold text-slate-600 mb-3" x-text="label"></h4>
											<template x-for="(item, index) in causes[key]" :key="index">
												<div class="flex gap-4 hover:bg-base-300 items-center mb-2">
													<div class="flex-1 ">
														<div class="flex flex-col">
															{{ template "select_input" (dict
																"Model" "item.scat_option_id"
																"Placeholder" "Pilih"
																"Required" true
																"Class" "w-96"
																"Slot" "<template x-for='opt in getScatOptions(key)' :key='opt.ID'><option :value='opt.ID' :selected='opt.ID == item.scat_option_id' x-text='opt.Code + \" - \" + opt.Name'></option></template>"
																)
															}}
															{{ template "textarea" (dict
																"Label" ""
																"Name" "description_cause"
																"Placeholder" "Sub-alasan..."
																"Required" true
																"Attr" " x-model='item.description'"
																)
															}}
														</div>
													</div>
													<div class="w-14 flex-none">
														<div class="w-14 flex-none">
															<div class="tooltip" :data-tip="'Hapus ' + label">
																<button type="button" @click="causes[key].splice(index, 1)"  class="btn btn-xs btn-square btn-soft btn-error ">
																	{{ lucide "circle-x" (dict "class" "size-4") }} 
																</button>
															</div>
														</div>
													</div>
												</div>
											</template>
											<div class="justify-end card-actions">
												<button 
													type="button" 
													class="btn btn-accent btn-dash btn-xs mt-2"
													@click="causes[key].push({category_type: key, scat_option_id: '', description: ''})" >
													{{ lucide "plus" (dict "class" "size-4") }} {{ index .Tr "TambahBaris" }} <span x-text="label"></span>
												</button>
											</div>
										</div>
									</div>
								</template>
							</div>
						</div>
					</div>
				</template>
			</div>
		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab7">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 7" @change="activeTab = 7" />
		<div class="collapse-title font-semibold"><h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian7" }}</h3></div>
		<div class="collapse-content ">
			<div>
				<template x-if="activeTab === 7">
					<template x-for="(item, index) in corrective_actions" :key="item.key_id || index">
						<div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md transition-shadow">
							<div class="card-body p-4 gap-4 overflow-y-scroll">
								<div class="flex justify-between items-start">
									<h3 class="font-bold text-sm opacity-60">Action #<span x-text="index + 1"></span></h3>
									<button type="button" @click="removeCorrectiveAction(index)" class="btn btn-ghost btn-xs text-error">
										{{ lucide "trash-2" (dict "class" "size-4") }} Hapus
									</button>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
									<div class="md:col-span-2">
										{{ template "textarea" (dict
											"Label" ""
											"Name" "description_cause"
											"Placeholder" "Action..."
											"Required" true
											"Attr" " x-model='item.action'"
											)
										}}
									</div>
									<div>
										{{ template "textarea" (dict
											"Label" ""
											"Name" "description_cause"
											"Placeholder" "Control Hierarchy..."
											"Required" true
											"Attr" " x-model='item.control_hierarchy'"
											)
										}}
									</div>
								</div>
								<div class="flex gap-4 items-end">
									<div class="flex-1">


										{{ template "select-user-search_model" (dict
											"Label" ""
											"Name" "user_id"
											"Options" .Users
											"Model" "item.user_id"
											"DefaultText" (index .Tr "InputPIC")
											"Required" true
											)
										}}
									</div>
									<div class="w-48">
										{{ template "input-tanggal" (dict
											"Label" ""
											"Name" "due_date"
											"Id" ""
											"Value" ""
											"Static" "false"
											"Type" "date"
											"Placeholder" (index .Tr "DueDate")
											"Required" false
											"RequiredBinding" ""
											"Attr" "x-model='item.due_date' :id=\"'due_date_' + index\" :name=\"'corrective_actions['+index+'][due_date]'\""
											)
										}}
									</div>
								</div>
							</div>
						</div>
					</template>
				</template>
			</div>
			<div class="mt-2">
				<button 
					type="button" 
					class="btn btn-accent btn-soft btn-sm"
					@click="addCorrectiveAction()">
					{{ lucide "plus" (dict "class" "size-4") }} {{ index .Tr "TambahBaris" }}
				</button>
			</div>
		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab8">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 8" @change="activeTab = 8" />
		<div class="collapse-title font-semibold">
			<h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian8" }}</h3>
			<p class="text-xs text-slate-500">{{ index .Tr "SubBagian8" }}</p>
		</div>
		<div class="collapse-content ">
			<div>
				<template x-if="activeTab === 8">
					{{ template "ckeditor" dict "ID" "KeyLearning" "Label" "" "Name" "tugas_dijalankan" "Model" "KeyLearning" "Value" .Incident.KeyLearning "Required" true "Attr" "" }}
				</template>
			</div>
		</div>
	</div>
	<div class="collapse collapse-arrow bg-base-100 border border-base-300 mb-2" x-ref="tab9">
		<input type="radio" name="my-accordion-1" :checked="activeTab === 9" @change="activeTab = 9" />
		<div class="collapse-title font-semibold">
			<h3 class="text-lg font-bold text-slate-700">{{ index .Tr "Bagian9" }}</h3>
		</div>
		<div class="collapse-content ">
			<div>
				<template x-if="activeTab === 9">
					<template x-for="(reviewer, index) in reviewerConfigs" :key="reviewer.key">
						<div class="border border-base-300 rounded-lg overflow-hidden bg-base-100 shadow-sm relative" 
							x-show="isReviewVisible(reviewer.key)">

							<div x-show="!isReviewUnblocked(index)" 
								class="absolute inset-0 z-10 bg-base-100/40 backdrop-blur-[1px] flex items-center justify-center transition-all duration-300"
								x-cloak>
								<div class="bg-base-100 px-4 py-2 rounded-full shadow-md border border-base-300 text-xs font-semibold text-base-content/70 flex items-center gap-2">
									<span>🔒</span> Menunggu giliran...
								</div>
							</div>

							<div :class="!isReviewUnblocked(index) ? 'opacity-40 pointer-events-none select-none' : ''" class="transition-opacity duration-300">

								<div class="bg-base-200/60 px-4 py-2 border-b border-base-300 flex justify-between items-center">
									<span class="font-bold text-sm text-base-content/80">
										<span x-text="reviewer.title"></span>
										<span class="text-error" x-text="isReviewRequired(reviewer.key) ? ' *' : ''"></span>
									</span>

									<div>
										<span x-show="isReviewComplete(reviewer.key)" class="badge badge-success badge-xs text-[10px] text-white">Selesai</span>
										<span x-show="isReviewUnblocked(index) && !isReviewComplete(reviewer.key)" class="badge badge-info badge-xs text-[10px] text-white">Wajib Diisi</span>
									</div>
								</div>

								<div class="p-4 flex flex-col gap-4">
									{{ template "ckeditor-loop" (dict
										"Label" "Komentar"
										"Name" "reviewer.key + '_comment'"
										"ID" "`reviews_${index}`"
										"AlpineVar" "reviews[reviewer.key].comment"
										"RequiredBinding" "isReviewRequired(reviewer.key)"
										)
									}}

									<div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
										{{ template "select-user-search_model" (dict
											"Label" "Nama Peninjau"
											"Name" "reviewer.key + '_user_id'"
											"Options" .Users
											"Model" "reviews[reviewer.key].user_id"
											"DefaultText" (index .Tr "InputPeninjauan")
											"RequiredBinding" "isReviewRequired(reviewer.key)"
											)
										}}
										<fieldset class="fieldset w-full">

											<label class="label ">

												<span class="text-xs font-bold text-base-content opacity-60">Tanda Tangan:</span>

											</label>

											<div class=" flex items-end  border-b-2 border-dashed border-base-300">

												<span x-show="reviews[reviewer.key].accepted !== null" class="text-success text-xs font-bold" x-cloak>

													✓ Ditandatangani Digital

												</span>

												<span x-show="reviews[reviewer.key].accepted === null" class="text-base-content/40 text-xs italic">

													Menunggu Persetujuan...

												</span>

											</div>

										</fieldset>

										{{ template "radio_group" (dict
											"Label" "Penerimaan"
											"Name" "reviewer.key + '_accepted'"
											"Model" "reviews[reviewer.key].accepted"
											"RequiredBinding" "isReviewRequired(reviewer.key)"
											)
										}}
									</div>
								</div>
							</div>
						</div>
					</template>
				</template>
			</div>
		</div>
	</div>
</div>

{{ end }}