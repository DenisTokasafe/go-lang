{{ define "content" }}
<div class="bg-base-200 min-h-screen flex items-center justify-center p-4 antialiased w-full">

	<div class="max-w-md w-full text-center space-y-6">
		<div class="flex justify-center">
			<div class="p-5 bg-error/10 text-error rounded-full inline-flex items-center justify-center">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
					<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
				</svg>
			</div>
		</div>

		<div class="space-y-2">
			<h1 class="text-7xl font-extrabold font-mono text-base-content/30 tracking-tight">
				403
			</h1>
			<h2 class="text-xl font-bold text-base-content/80">
				Akses Ditolak / Unauthorized
			</h2>
			<p class="text-sm text-base-content/60 max-w-sm mx-auto leading-relaxed">
				Anda tidak memiliki akses untuk mengubah laporan ini. Halaman ini dilindungi oleh kebijakan kontrol akses K3 (HSE System).
			</p>
		</div>

		<div class="flex flex-col sm:flex-row gap-2 justify-center pt-2">
			<a href="/hazard" class="btn btn-outline btn-sm sm:btn-md text-sm border-base-content/20 hover:bg-base-content/10 font-medium">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
				</svg>
				Daftar Hazard
			</a>
			<a href="/dashboard" class="btn btn-neutral btn-sm sm:btn-md text-sm font-medium shadow-sm">
				Ke Dashboard
			</a>
		</div>

		<div class="text-xs text-base-content/30 font-mono pt-4 select-none">
			SENTRY Interlock Security Guard
		</div>
	</div>

</div>
{{ end }}