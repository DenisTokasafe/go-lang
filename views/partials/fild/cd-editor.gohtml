{{ define "ckeditor" }}
<div class="mt-2" x-data="{ isInvalid: false }">

	{{ if .Label }}
		<label class="label">
			<span class="text-xs font-bold text-base-content opacity-60">
				{{ .Label }}

				{{ if or .Required .RequiredBinding }}
					<span class="text-error font-bold ml-0.5">*</span>
				{{ end }}
			</span>
		</label>
	{{ end }}

	<div class="border rounded-md overflow-hidden"
		:class="isInvalid ? 'border-error' : 'border-base-300'">

		<div x-init="
			(async () => {
			try {

			const ClassicEditor = await window.ClassicEditor;

			const editor = await ClassicEditor.create($refs.editor, {
			toolbar: [
			'heading',
			'|',
			'bold',
			'italic',
			'link',
			'bulletedList',
			'numberedList',
			'blockQuote'
			]
			});

			// =========================
			// DISABLED SUPPORT
			// =========================
{{ if .DisabledBinding }}

			const applyReadOnly = () => {

			if ({{ .DisabledBinding }}) {

			editor.enableReadOnlyMode('lock');

			editor.ui.view.editable.element.classList.add(
			'bg-base-200',
			'cursor-not-allowed',
			'opacity-70'
			);

			} else {

			editor.disableReadOnlyMode('lock');

			editor.ui.view.editable.element.classList.remove(
			'bg-base-200',
			'cursor-not-allowed',
			'opacity-70'
			);
			}
			};

			applyReadOnly();

			$watch(
			() => {{ .DisabledBinding }},
			() => applyReadOnly()
			);

{{ end }}

			// =========================
			// INITIAL VALUE (AMAN & ESCAPE)
			// =========================
			const initialData = {{ if .Value }}{{ printf "%q" .Value }}{{ else }}''{{ end }};

			editor.setData(initialData);

			// =========================
			// SYNC CKEDITOR -> TEXTAREA
			// =========================
			editor.model.document.on('change:data', () => {

			const data = editor.getData();

			$refs.editor.value = data;

			isInvalid = false;

			$refs.editor.dispatchEvent(new Event('input'));
			});

			} catch (error) {
			console.error('CKEditor Error:', error);
			}
			})()
			">

			<textarea
				id="{{ .ID }}"
				x-ref="editor"
				name="{{ .Name }}"
				class="hidden"
			{{ .Attr }}
				{{ if .Required }} required {{ end }}
				{{ if .Placeholder }} placeholder="{{ .Placeholder }}" {{ end }}
				{{ if .RequiredBinding }} x-bind:required="{{ .RequiredBinding }}" {{ end }}
				@invalid.prevent="isInvalid = true"
				@input="isInvalid = false"
				aria-label="{{ .Label }}"
			>{{ .Value }}</textarea>

		</div>
	</div>

	<div x-show="isInvalid" x-cloak class="text-error text-[9px] font-semibold leading-none mt-1">
		{{ .Label }} wajib diisi.
	</div>

</div>
{{ end }}