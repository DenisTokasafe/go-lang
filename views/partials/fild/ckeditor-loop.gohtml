{{ define "ckeditor-loop" }}
<div class="mt-2" x-data="{ isInvalid: false }">

    {{ if .Label }}
    <label class="label">
        <span class="text-xs font-bold text-base-content opacity-60">
            {{ .Label }}

            {{ if or .Required .RequiredBinding }}
            <span class="text-error font-bold ml-0.5">*</span>
            {{ end }}

        </span>
    </label>
    {{ end }}

    <div
        class="border rounded-md overflow-hidden"
        :class="isInvalid ? 'border-error' : 'border-base-300'">

        <div
            x-init="
            (async () => {

                try {

                    // =========================
                    // LOAD CKEDITOR
                    // =========================
                    const ClassicEditor =
                    await window.ClassicEditor;

                    // =========================
                    // CREATE EDITOR
                    // =========================
                    const editor =
                    await ClassicEditor.create(
                        $refs.editor,
                        {
                            toolbar: [
                                'heading',
                                '|',
                                'bold',
                                'italic',
                                'link',
                                'bulletedList',
                                'numberedList',
                                'blockQuote'
                            ]
                        }
                    );

                    // =========================
                    // SAVE INSTANCE
                    // =========================
                    $el._editor = editor;

                    // =========================
                    // INITIAL VALUE
                    // =========================
                    let initialData = '';

                    {{ if .Value }}

                    initialData = `{{ .Value }}`;

                    {{ else if .AlpineVar }}

                    initialData =
                    {{ .AlpineVar }} || '';

                    {{ end }}

                    editor.setData(initialData);

                    // =========================
                    // CKEDITOR -> ALPINE
                    // =========================
                    editor.model.document.on(
                        'change:data',
                        () => {

                            const htmlData =
                            editor.getData();

                            $refs.editor.value =
                            htmlData;

                            isInvalid = false;

                            {{ if .AlpineVar }}

                            {{ .AlpineVar }} =
                            htmlData;

                            {{ end }}

                            $refs.editor.dispatchEvent(
                                new Event('input')
                            );
                        }
                    );

                    // =========================
                    // ALPINE -> CKEDITOR
                    // =========================
                    {{ if .AlpineVar }}

                    $watch(
                        '{{ .AlpineVar }}',
                        (newVal) => {

                            if (
                                newVal !==
                                editor.getData()
                            ) {

                                editor.setData(
                                    newVal || ''
                                );

                            }
                        }
                    );

                    {{ end }}

                } catch (error) {

                    console.error(
                        'CKEditor Error:',
                        error
                    );

                }

            })()
            "

             x-effect="
    if ($el._editor && !$el.isConnected) {

        $el._editor.destroy()
        .catch(err => console.log(err))

    }
    ">

            <textarea
                x-bind:id="{{ .ID }}"
                x-ref="editor"
                name="{{ .Name }}"
                class="hidden"

                {{ if .AlpineVar }}
                x-model="{{ .AlpineVar }}"
                {{ end }}

                {{ .Attr }}

                {{ if .Required }}
                required
                {{ end }}

                {{ if .RequiredBinding }}
                x-bind:required="{{ .RequiredBinding }}"
                {{ end }}

                @invalid.prevent="isInvalid = true"
                @input="isInvalid = false"

                aria-label="{{ .Label }}">

                {{ .Value }}

            </textarea>

        </div>
    </div>

    <div
        x-show="isInvalid"
        x-cloak
        class="text-error text-[9px] font-semibold leading-none mt-1">

        Field {{ .Label }} wajib diisi.

    </div>
</div>
{{ end }}