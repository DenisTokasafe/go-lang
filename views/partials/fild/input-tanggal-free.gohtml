{{ define "input-tanggal" }}
<fieldset
	class=""
	x-modelable="value"
	x-data="{
	value: '{{ .Value }}',
	isInvalid: false,
	errorMsg: '',
	_fp: null,

	cleanFormat(val) {
	if (!val) return '';
	if (val.includes('T')) {
{{ if eq .Type "date" }}
	return val.split('T')[0]; 
{{ else }}
	return val.replace('T', ' ').substring(0, 16); 
{{ end }}
	}
	return val;
	},

	validate() {
	const isRequired =
{{ if .Required }}
	true
{{ else if .RequiredBinding }}
{{ .RequiredBinding }}
{{ else }}
	false
{{ end }};

	if (isRequired && (!this.value || this.value.trim() === '')) {
	this.isInvalid = true;
	this.errorMsg = '{{ .Label }} wajib diisi.';
	this.updateStyles();
	return false;
	}

	this.isInvalid = false;
	this.errorMsg = '';
	this.updateStyles();
	return true;
	},

	updateStyles() {
	if (this._fp && this._fp.altInput) {
	if (this.isInvalid) {
	this._fp.altInput.classList.add('input-error');
	} else {
	this._fp.altInput.classList.remove('input-error');
	}
	}
	},

	reposition() {
	const button = this.$refs.triggerButton;
	const popover = this.$refs.dropdownPopover;
	if (!button || !popover) return;

	const rect = button.getBoundingClientRect();
	const popoverHeight = 220; 
	const spaceBelow = window.innerHeight - rect.bottom;
	const margin = 10;

	if (spaceBelow < popoverHeight + margin && rect.top > popoverHeight + margin) {
	popover.style.top = `${rect.top - popoverHeight - 4}px`;
	} else {
	popover.style.top = `${rect.bottom + 4}px`;
	}

	popover.style.left = `${rect.left}px`;
	popover.style.width = `${rect.width}px`;
	},

	async init() {
	if ((this.value === undefined || this.value === '') && '{{ .Value }}' !== '') {
	this.value = '{{ .Value }}';
	}

	const pickerSetup = await window.setupDatepicker({
	enableTime: {{ if eq .Type "date" }}false{{ else }}true{{ end }},
	altFormat: {{ if eq .Type "date" }}'j F, Y'{{ else }}'j F, Y H:i'{{ end }},
	dateFormat: {{ if eq .Type "date" }}'Y-m-d'{{ else }}'Y-m-d H:i'{{ end }},
	time_24hr: true,
	disableMobile: false,
	static: {{ if eq .Static "false" }}false{{ else }}true{{ end }},
	minuteIncrement: 1,
	altInputClass: 'input input-bordered input-xs w-full focus:outline-none focus:border-info focus:ring-info'
	});

	if (this.value) {
	pickerSetup.value = this.cleanFormat(this.value);
	}

	// 1. Jalankan inisialisasi Flatpickr bawaan sistem Anda
	pickerSetup.init.call(this);

	// 🔥 PERBAIKAN UTAMA: Beri jeda mikro 50ms agar objek `this._fp` selesai terbentuk sempurna di DOM
	setTimeout(() => {
	if (this._fp && this.value) {
	this._fp.setDate(this.cleanFormat(this.value), false);
	}
	if (this.value) {
	this.validate();
	}
	}, 50);

	// 2. Pantau perubahan data secara dinamis di kemudian waktu
	this.$watch('value', val => {
	if (this._fp) {
	if (!val) {
	this._fp.clear();
	} else {
	this._fp.setDate(this.cleanFormat(val), false); 
	}
	}

	this.$dispatch('input', val);
	this.$dispatch('change', val);
	this.validate(); 
	});

{{ if .RequiredBinding }}
	this.$watch(
	() => {{ .RequiredBinding }},
	(val) => {
	if (!val) {
	this.isInvalid = false;
	this.errorMsg = '';
	this.updateStyles();
	} else {
	this.validate();
	}
	}
	);
{{ end }}
	}
	}"
	@validate-me="validate()"
	{{ with .Attr }}{{ . | htmlattr }}{{ end }}>

	{{ if .Label }}
		<label class="label">
			<span class="text-xs font-bold text-base-content opacity-60">
				{{ .Label }}
				{{ if or .Required .RequiredBinding }}
					<span class="text-error font-bold ml-0.5">*</span>
				{{ end }}
			</span>
		</label>
	{{ end }}

	<div class="relative w-full" x-ref="dropdownPopover">
		<input
			type="text"
			name="{{ .Name }}"
			id="{{ .Id }}"
			x-ref="datepicker"
			value="{{ .Value }}"
			placeholder="{{ .Placeholder }}"
			@change="validate()"
			@input="validate()"
			@invalid.prevent="validate()"
			:class="isInvalid ? 'input-error' : 'focus:input-info'"
			class="input input-xs w-full focus:outline-none focus:border-info leading-normal focus:ring-info appearance-none"

			{{ if .Required }} required {{ end }}
			{{ if .DisabledBinding }} :disabled="{{ .DisabledBinding }}" {{ end }}
			{{ if .RequiredBinding }} x-bind:required="{{ .RequiredBinding }}" {{ end }}
		/>
	</div>

	<div x-show="isInvalid && errorMsg" x-cloak class="mt-1">
		<p class="text-error text-[9px] font-semibold leading-none" x-text="errorMsg"></p>
	</div>
</fieldset>
<style>
    .flatpickr-wrapper {
        display: block !important;
        width: 100% !important;
    }
</style>
{{ end }}