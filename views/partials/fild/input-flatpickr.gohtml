{{ define "input-flatpickr" }}
<fieldset
	class=""
	x-modelable="value"
	x-data="{
	value: '{{ .Value }}',
	isInvalid: false,
	errorMsg: '',
	_fp: null,
	isDisabled: {{ if .DisabledBinding }}{{ .DisabledBinding }}{{ else }}false{{ end }},

	// =========================================================
	// ✅ FUNGSI KONSISTENSI DISABLED (INPUT ASLI & VISUAL)
	// =========================================================
	setDisabled(val) {
	this.isDisabled = Boolean(val);
	if (this._fp) {
	// Kunci input asli
	if (this._fp._input) {
	this._fp._input.disabled = this.isDisabled;
	}
	// Kunci input visual (altInput) & berikan style Tailwind/DaisyUI
	if (this._fp.altInput) {
	this._fp.altInput.disabled = this.isDisabled;
	if (this.isDisabled) {
	this._fp.altInput.classList.add('opacity-50', 'cursor-not-allowed', 'bg-base-200');
	} else {
	this._fp.altInput.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-base-200');
	}
	}
	}
	},

	isFuture(val) {
	if (!val) return false;
	const inputDate = new Date(val);
	const now = new Date();
	return inputDate > now;
	},

	validate() {
	// Jika dalam posisi disabled, lewati validasi agar tidak muncul error
	if (this.isDisabled) {
	this.isInvalid = false;
	this.errorMsg = '';
	this.updateStyles();
	return true;
	}

	const isRequired =
{{ if .Required }}
	true
{{ else if .RequiredBinding }}
{{ .RequiredBinding }}
{{ else }}
	false
{{ end }};

	if (isRequired && (!this.value || String(this.value).trim() === '')) {
	this.isInvalid = true;
	this.errorMsg = '{{ .Label }} wajib diisi.';
	this.updateStyles();
	return false;
	}

	if (this.value && this.isFuture(this.value)) {
	this.isInvalid = true;
	this.errorMsg = 'Tanggal tidak boleh melebihi waktu sekarang.';
	this.updateStyles();
	return false;
	}

	this.isInvalid = false;
	this.errorMsg = '';
	this.updateStyles();
	return true;
	},

	updateStyles() {
	if (this._fp && this._fp.altInput) {
	if (this.isInvalid) {
	this._fp.altInput.classList.add('input-error');
	} else {
	this._fp.altInput.classList.remove('input-error');
	}
	}
	},

	async init() {
	// 💡 JALUR PENYELAMATAN DATA: Jika x-model parent sempat mengosongkan state saat binding awal
	if ((this.value === undefined || this.value === '') && '{{ .Value }}' !== '') {
	this.value = '{{ .Value }}';
	}

	const pickerSetup = await window.setupDatepicker({
	enableTime: {{ if eq .Type "date" }}false{{ else }}true{{ end }},
	altFormat: {{ if eq .Type "date" }}'j F, Y'{{ else }}'j F, Y H:i'{{ end }},
	dateFormat: {{ if eq .Type "date" }}'Y-m-d'{{ else }}'Y-m-d H:i'{{ end }},
	time_24hr: true,
	disableMobile: true,
	static: {{ if eq .Static "false" }}false{{ else }}true{{ end }},
	minuteIncrement: 1,
	altInputClass: 'input input-bordered input-xs w-full focus:outline-none focus:border-info focus:ring-info'
	});

	pickerSetup.value = this.value;
	pickerSetup.init.call(this);

	// 💡 TERAPKAN STATUS DISABLED & INITIAL VALUE SECARA INSTAN SAAT RENDER SELESAI
	this.$nextTick(() => {
	if (this._fp && this.value) {
	this._fp.setDate(this.value, false);
	}
	this.setDisabled(this.isDisabled);
	if (this.value) this.validate();
	});

	// Pantau perubahan nilai tanggal
	this.$watch('value', val => {
	this.$dispatch('input', val);
	this.$dispatch('change', val);
	this.validate(); 
	});

{{ if .RequiredBinding }}
	this.$watch(
	() => {{ .RequiredBinding }},
	(val) => {
	if (!val) {
	this.isInvalid = false;
	this.errorMsg = '';
	this.updateStyles();
	} else {
	this.validate();
	}
	}
	);
{{ end }}

{{ if .DisabledBinding }}
	// 💡 PANTAU PERUBAHAN STATUS DISABLED DARI FRONTEND (REAKTIF)
	this.$watch(
	() => {{ .DisabledBinding }},
	(val) => {
	this.setDisabled(val);
	if (val) {
	// Bersihkan error jika elemen berubah menjadi disabled
	this.isInvalid = false;
	this.errorMsg = '';
	this.updateStyles();
	} else {
	this.validate();
	}
	}
	);
{{ end }}
	}
	}"
	@validate-me="validate()"
	{{ with .Attr }}{{ . | htmlattr }}{{ end }}>

	{{ if .Label }}
		<label class="label">
			<span class="text-xs font-bold text-base-content opacity-60">
				{{ .Label }}
				{{ if or .Required .RequiredBinding }}
					<span class="text-error font-bold ml-0.5">*</span>
				{{ end }}
			</span>
		</label>
	{{ end }}

	<div class="relative w-full">
		<input
			type="text"
			name="{{ .Name }}"
			id="{{ .Id }}"
			x-ref="datepicker"
			value="{{ .Value }}" 
			placeholder="{{ .Placeholder }}"
			@change="validate()"
			@input="validate()"
			@invalid.prevent="validate()"
			:class="isInvalid ? 'input-error' : 'focus:input-info'"
			class="input input-xs w-full focus:outline-none focus:border-info leading-normal focus:ring-info appearance-none"

			{{ if .Required }} required {{ end }}
			:disabled="isDisabled" 
			{{ if .RequiredBinding }} x-bind:required="{{ .RequiredBinding }}" {{ end }}
		/>
	</div>

	<div x-show="isInvalid && errorMsg" x-cloak class="mt-1">
		<p class="text-error text-[9px] font-semibold leading-none" x-text="errorMsg"></p>
	</div>
</fieldset>
<style>
    .flatpickr-wrapper {
        display: block !important;
        width: 100% !important;
    }
</style>
{{ end }}