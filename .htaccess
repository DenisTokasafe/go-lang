Options +FollowSymLinks +ExecCGI
AddHandler fcgi-script .fcgi
DirectoryIndex app.fcgi

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 1. Jika user mengakses file fisik asli (seperti css, js, gambar di folder public), langsung izinkan
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# 2. Lempar request ke app.fcgi TANPA mengubah REQUEST_URI asli yang dibaca Go
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ app.fcgi [L]
</IfModule>